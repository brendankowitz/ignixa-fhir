<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Console application for generating C# IStructureDefinitionSummaryProvider from FHIR packages -->
    <Description>Console application for generating C# IStructureDefinitionSummaryProvider from FHIR packages</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project references to fhir-codegen projects -->
    <!-- Note: fhir-codegen uses Firely SDK 5.13.1, not 6.0.0-rc1 -->
    <ProjectReference Include="..\fhir-codegen\src\Fhir.CodeGen.Lib\Fhir.CodeGen.Lib.csproj" />
    <ProjectReference Include="..\fhir-codegen\src\Fhir.CodeGen.Common\Fhir.CodeGen.Common.csproj" />
  </ItemGroup>

</Project>

