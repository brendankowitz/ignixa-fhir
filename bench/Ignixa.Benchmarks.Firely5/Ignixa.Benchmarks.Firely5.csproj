<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Hl7.Fhir.R4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ignixa core only. None of these reference Hl7.Fhir, so the 5.11.4 pin above is unopposed. -->
    <ProjectReference Include="..\..\src\Core\Ignixa.Search\Ignixa.Search.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.Serialization\Ignixa.Serialization.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.FhirPath\Ignixa.FhirPath.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.Specification\Ignixa.Specification.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Ignixa.Benchmarks\TestData\*.json" LinkBase="TestData" />
  </ItemGroup>

</Project>
