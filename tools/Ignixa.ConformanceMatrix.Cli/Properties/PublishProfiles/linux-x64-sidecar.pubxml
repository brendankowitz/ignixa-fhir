<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained linux-x64 single-file build of the ignixa-matrix `serve` runner, for use as an
  Azure Load Testing artifact: uploaded in a zip alongside a locustfile, spawned once per Locust
  engine instance at test start, and chmod +x'd / run over 127.0.0.1 as a co-located sidecar.
  See docs/features/load-testing/investigations/azure-load-testing-locust.md.

  Usage: dotnet publish -p:PublishProfile=linux-x64-sidecar -c Release
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>bin\Release\net10.0\linux-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
