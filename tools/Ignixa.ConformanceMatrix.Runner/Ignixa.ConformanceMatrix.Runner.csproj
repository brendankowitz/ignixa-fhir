<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ignixa.ConformanceMatrix.Runner</RootNamespace>
    <AssemblyName>ignixa-matrix-runner</AssemblyName>
    <!-- Unlike the one-shot CLI, this project hosts a network service, so CA1031 (catch general
         exceptions) and CA2000 (dispose objects before losing scope) stay enabled — the few
         boundary sites that legitimately need them carry targeted suppressions. -->
    <NoWarn>CA1303,CA1869,CA1861,CA1852,IDE0073,CA1307,CA1310,CA1711,CA1716,CA1849,CA1859</NoWarn>
  </PropertyGroup>

  <!-- NuGet Package & Tool Configuration -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageStability>beta</PackageStability>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ignixa-matrix-runner</ToolCommandName>
    <PackageId>Ignixa.ConformanceMatrix.Runner</PackageId>
    <Description>Load-test runner that hosts FHIR TestScript suites behind a local HTTP endpoint (Azure Load Testing / Locust sidecar). Companion to the ignixa-matrix CLI.</Description>
    <PackageTags>$(PackageTags);fhir;cli;tool;testscript;load-testing</PackageTags>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- Kestrel + minimal APIs for the load-test runner host. This framework reference is why serve
       lives in its own tool: keeping it out of Ignixa.ConformanceMatrix.Cli lets the base
       ignixa-matrix tool run on machines with only the Microsoft.NETCore.App runtime. The legacy
       Microsoft.AspNetCore.Http 2.x package is pinned in Directory.Packages.props for another
       project and must not be referenced here instead. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Ignixa.ConformanceMatrix.Shared\AuthHeader.cs" Link="Shared\AuthHeader.cs" />
    <Compile Include="..\Ignixa.ConformanceMatrix.Shared\ExitCodes.cs" Link="Shared\ExitCodes.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Ignixa.TestScript\Ignixa.TestScript.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.TestScript.FhirFakes\Ignixa.TestScript.FhirFakes.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.Specification\Ignixa.Specification.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.Serialization\Ignixa.Serialization.csproj" />
  </ItemGroup>

</Project>
