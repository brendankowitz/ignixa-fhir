<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Raw ADO.NET only: no EF Core, no ORM of any kind (design doc section 4: hard architectural constraint) -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Polly" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!-- Schema deployment (Task 4) -->
    <PackageReference Include="Microsoft.SqlServer.DacFx" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project references -->
    <ProjectReference Include="..\..\Application\Ignixa.Domain\Ignixa.Domain.csproj" />
    <!-- Owns ISourceEventStore, which SqlServerSourceEventStore implements (Phase F Task 1) -->
    <ProjectReference Include="..\..\Application\Ignixa.Conformance.Events\Ignixa.Conformance.Events.csproj" />
    <!-- RowGenerators (Phase D Task 1 copy) reference SqlCatalog for column/table facts -->
    <ProjectReference Include="..\..\Core\Ignixa.Search.Sql\Ignixa.Search.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ignixa.DataLayer.SqlServer.Database is a .sqlproj: it doesn't compose via <ProjectReference>
         the normal way. Reference its built .dacpac directly and embed it; the explicit
         ReferenceOutputAssembly="false" ProjectReference below only enforces build order. -->
    <None Include="..\Ignixa.DataLayer.SqlServer.Database\bin\$(Configuration)\Ignixa.DataLayer.SqlServer.Database.dacpac">
      <Link>Resources\Schema.dacpac</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="..\Ignixa.DataLayer.SqlServer.Database\bin\$(Configuration)\Ignixa.DataLayer.SqlServer.Database.dacpac">
      <LogicalName>Ignixa.DataLayer.SqlServer.Schema.dacpac</LogicalName>
    </EmbeddedResource>
    <ProjectReference Include="..\Ignixa.DataLayer.SqlServer.Database\Ignixa.DataLayer.SqlServer.Database.sqlproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ignixa.DataLayer.SqlServer.Tests" />
    <InternalsVisibleTo Include="Ignixa.DataLayer.SqlServer.IntegrationTests" />
    <!-- Ignixa.SchemaUpgrade.Cli (Phase C Task 6) re-uses SqlExecutionService.ResolveConnectionStringAsync
         rather than duplicating tenant-storage-type/inheritance resolution logic. -->
    <InternalsVisibleTo Include="Ignixa.SchemaUpgrade.Cli" />
  </ItemGroup>

</Project>
