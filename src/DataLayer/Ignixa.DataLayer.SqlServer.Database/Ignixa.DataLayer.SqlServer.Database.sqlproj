<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />
  <PropertyGroup>
    <Name>Ignixa.DataLayer.SqlServer.Database</Name>
    <!-- SQL Server 2022. Deliberately not Sql170 (SQL Server 2025): DacFx refuses to publish a
         2025-targeted project to an older server, and both the CI test container
         (docker-compose.test.yml: mssql/server:2022) and Azure SQL are on 2022-era engines. The
         schema uses no 2025-only features, so the lower target is strictly more portable. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>0D46D298-89F4-43E1-B6B6-4F560D86D637</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="Scripts\Script.PostDeployment.sql" />
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
  </ItemGroup>
</Project>