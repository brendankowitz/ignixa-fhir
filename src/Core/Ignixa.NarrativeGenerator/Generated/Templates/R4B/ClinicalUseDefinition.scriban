{{~ # Auto-generated Scriban narrative template for ClinicalUseDefinition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ClinicalUseDefinition ~}}

<div class="fhir-narrative fhir-clinicalusedefinition" lang="{{ l10n.lang }}">
