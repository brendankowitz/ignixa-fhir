      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ClinicalUseDefinition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ClinicalUseDefinition.Type" }}</dt>
    <dd>{{ fhir.path resource "type" }}</dd>
    {{~ if (fhir.exists resource "contraindication") ~}}
    <dt>{{ l10n.t "ClinicalUseDefinition.Contraindication" }}</dt>
