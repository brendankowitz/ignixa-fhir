        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "undesirableEffect") ~}}
    <dt>{{ l10n.t "ClinicalUseDefinition.UndesirableEffect" }}</dt>
