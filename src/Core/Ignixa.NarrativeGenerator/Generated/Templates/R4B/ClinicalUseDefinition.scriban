    {{~ if (fhir.exists resource "indication") ~}}
    <dt>{{ l10n.t "ClinicalUseDefinition.Indication" }}</dt>
    <dd>{{ fhir.path resource "indication" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "interaction") ~}}
    <dt>{{ l10n.t "ClinicalUseDefinition.Interaction" }}</dt>
    <dd>{{ fhir.path resource "interaction" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "population") ~}}
