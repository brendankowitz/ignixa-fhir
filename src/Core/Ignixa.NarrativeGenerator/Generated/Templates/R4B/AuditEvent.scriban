{{~ # Auto-generated Scriban narrative template for AuditEvent ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/AuditEvent ~}}

<div class="fhir-narrative fhir-auditevent" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "AuditEvent.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "AuditEvent.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "AuditEvent.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "AuditEvent.Recorded" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "recorded") }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "AuditEvent.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "AuditEvent.Type" }}</dt>
    <dd>{{ fhir.display_coding (fhir.path resource "type") }}</dd>
    {{~ if (fhir.exists resource "subtype") ~}}
    <dt>{{ l10n.t "AuditEvent.Subtype" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "subtype") ~}}
        <li>{{ fhir.display_coding item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "action") ~}}
    <dt>{{ l10n.t "AuditEvent.Action" }}</dt>
    <dd>{{ fhir.path resource "action" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "outcome") ~}}
    <dt>{{ l10n.t "AuditEvent.Outcome" }}</dt>
    <dd>{{ fhir.path resource "outcome" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "outcomeDesc") ~}}
    <dt>{{ l10n.t "AuditEvent.OutcomeDesc" }}</dt>
    <dd>{{ fhir.path resource "outcomeDesc" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "purposeOfEvent") ~}}
    <dt>{{ l10n.t "AuditEvent.PurposeOfEvent" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "purposeOfEvent") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "AuditEvent.Agent" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "agent") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    <dt>{{ l10n.t "AuditEvent.Source" }}</dt>
    <dd>{{ fhir.path resource "source" }}</dd>
  </dl>

</div>
