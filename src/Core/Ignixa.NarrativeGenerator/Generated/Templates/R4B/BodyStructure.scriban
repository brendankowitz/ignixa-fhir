{{~ # Auto-generated Scriban narrative template for BodyStructure ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/BodyStructure ~}}

<div class="fhir-narrative fhir-bodystructure" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "BodyStructure.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "BodyStructure.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "BodyStructure.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "BodyStructure.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "BodyStructure.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "BodyStructure.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "BodyStructure.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "active") ~}}
    <dt>{{ l10n.t "BodyStructure.Active" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "active") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "morphology") ~}}
    <dt>{{ l10n.t "BodyStructure.Morphology" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "morphology") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "location") ~}}
    <dt>{{ l10n.t "BodyStructure.Location" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "location") }}</dd>
    {{~ end ~}}
  </dl>

</div>
