{{~ # Auto-generated Scriban narrative template for Ingredient ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Ingredient ~}}

<div class="fhir-narrative fhir-ingredient" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Ingredient.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Ingredient.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Ingredient.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Ingredient.Identifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "identifier") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Ingredient.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Ingredient.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "for") ~}}
    <dt>{{ l10n.t "Ingredient.For" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "for") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Ingredient.Role" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "role") }}</dd>
    {{~ if (fhir.exists resource "function") ~}}
    <dt>{{ l10n.t "Ingredient.Function" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "function") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "allergenicIndicator") ~}}
    <dt>{{ l10n.t "Ingredient.AllergenicIndicator" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "allergenicIndicator") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "manufacturer") ~}}
    <dt>{{ l10n.t "Ingredient.Manufacturer" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "manufacturer") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Ingredient.Substance" }}</dt>
    <dd>{{ fhir.path resource "substance" }}</dd>
  </dl>

</div>
