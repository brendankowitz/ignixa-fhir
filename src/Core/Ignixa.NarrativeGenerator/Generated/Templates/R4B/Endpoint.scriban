{{~ # Auto-generated Scriban narrative template for Endpoint ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Endpoint ~}}

<div class="fhir-narrative fhir-endpoint" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Endpoint.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Endpoint.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Endpoint.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Endpoint.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Endpoint.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "Endpoint.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Endpoint.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Endpoint.ConnectionType" }}</dt>
    <dd>{{ fhir.display_coding (fhir.path resource "connectionType") }}</dd>
    {{~ if (fhir.exists resource "managingOrganization") ~}}
    <dt>{{ l10n.t "Endpoint.ManagingOrganization" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "managingOrganization") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "period") ~}}
    <dt>{{ l10n.t "Endpoint.Period" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "period") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Endpoint.PayloadType" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "payloadType") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ if (fhir.exists resource "payloadMimeType") ~}}
    <dt>{{ l10n.t "Endpoint.PayloadMimeType" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "payloadMimeType") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Endpoint.Address" }}</dt>
    <dd>{{ fhir.path resource "address" }}</dd>
  </dl>

</div>
