{{~ # Auto-generated Scriban narrative template for VisionPrescription ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/VisionPrescription ~}}

<div class="fhir-narrative fhir-visionprescription" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "VisionPrescription.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "VisionPrescription.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "VisionPrescription.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "VisionPrescription.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "VisionPrescription.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "VisionPrescription.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "VisionPrescription.Encounter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "encounter") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "VisionPrescription.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "VisionPrescription.Created" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "created") }}</dd>
    <dt>{{ l10n.t "VisionPrescription.DateWritten" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "dateWritten") }}</dd>
    <dt>{{ l10n.t "VisionPrescription.Prescriber" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "prescriber") }}</dd>
    <dt>{{ l10n.t "VisionPrescription.LensSpecification" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "lensSpecification") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
  </dl>

</div>
