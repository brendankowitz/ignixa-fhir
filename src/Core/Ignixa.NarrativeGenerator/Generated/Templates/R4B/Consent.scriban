{{~ # Auto-generated Scriban narrative template for Consent ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Consent ~}}

<div class="fhir-narrative fhir-consent" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Consent.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Consent.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Consent.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Consent.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Consent.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "patient") ~}}
    <dt>{{ l10n.t "Consent.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "performer") ~}}
    <dt>{{ l10n.t "Consent.Performer" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "performer") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "dateTime") ~}}
    <dt>{{ l10n.t "Consent.DateTime" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "dateTime") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Consent.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Consent.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Consent.Scope" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "scope") }}</dd>
    {{~ if (fhir.exists resource "organization") ~}}
    <dt>{{ l10n.t "Consent.Organization" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "organization") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "source[x]") ~}}
    <dt>{{ l10n.t "Consent.Source" }}</dt>
    <dd>{{ fhir.path resource "source[x]" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "policyRule") ~}}
    <dt>{{ l10n.t "Consent.PolicyRule" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "policyRule") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "verification") ~}}
    <dt>{{ l10n.t "Consent.Verification" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "verification") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "provision") ~}}
    <dt>{{ l10n.t "Consent.Provision" }}</dt>
    <dd>{{ fhir.path resource "provision" }}</dd>
    {{~ end ~}}
  </dl>

</div>
