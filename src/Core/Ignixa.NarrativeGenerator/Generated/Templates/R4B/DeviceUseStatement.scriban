    {{~ if (fhir.exists resource "bodySite") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.BodySite" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "bodySite") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "basedOn") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.BasedOn" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "basedOn") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "derivedFrom") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.DerivedFrom" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "derivedFrom") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "timing[x]") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.Timing" }}</dt>
    <dd>{{ fhir.path resource "timing[x]" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recordedOn") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.RecordedOn" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "recordedOn") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "source") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.Source" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "source") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DeviceUseStatement.Device" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "device") }}</dd>
    {{~ if (fhir.exists resource "reasonCode") ~}}
    <dt>{{ l10n.t "DeviceUseStatement.ReasonCode" }}</dt>
    <dd>
      <ul class="fhir-list">
