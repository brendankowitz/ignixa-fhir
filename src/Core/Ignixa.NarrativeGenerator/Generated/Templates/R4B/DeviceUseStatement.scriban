{{~ # Auto-generated Scriban narrative template for DeviceUseStatement ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/DeviceUseStatement ~}}

<div class="fhir-narrative fhir-deviceusestatement" lang="{{ l10n.lang }}">
  <header class="fhir-header">
