{{~ # Auto-generated Scriban narrative template for Claim ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Claim ~}}

<div class="fhir-narrative fhir-claim" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Claim.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Claim.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Claim.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Claim.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Claim.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "Claim.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Claim.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Claim.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    <dt>{{ l10n.t "Claim.Use" }}</dt>
    <dd>{{ fhir.path resource "use" }}</dd>
    {{~ if (fhir.exists resource "billablePeriod") ~}}
    <dt>{{ l10n.t "Claim.BillablePeriod" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "billablePeriod") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Claim.Created" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "created") }}</dd>
    {{~ if (fhir.exists resource "insurer") ~}}
    <dt>{{ l10n.t "Claim.Insurer" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "insurer") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Claim.Provider" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "provider") }}</dd>
    <dt>{{ l10n.t "Claim.Priority" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "priority") }}</dd>
    <dt>{{ l10n.t "Claim.Insurance" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "insurance") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
  </dl>

</div>
