{{~ # Auto-generated Scriban narrative template for PaymentNotice ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/PaymentNotice ~}}

<div class="fhir-narrative fhir-paymentnotice" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "PaymentNotice.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "PaymentNotice.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "PaymentNotice.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "PaymentNotice.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "PaymentNotice.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "PaymentNotice.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "PaymentNotice.Created" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "created") }}</dd>
    <dt>{{ l10n.t "PaymentNotice.Payment" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "payment") }}</dd>
    <dt>{{ l10n.t "PaymentNotice.Recipient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "recipient") }}</dd>
    <dt>{{ l10n.t "PaymentNotice.Amount" }}</dt>
    <dd>{{ fhir.path resource "amount" }}</dd>
  </dl>

</div>
