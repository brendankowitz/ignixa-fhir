{{~ # Auto-generated Scriban narrative template for ManufacturedItemDefinition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ManufacturedItemDefinition ~}}

<div class="fhir-narrative fhir-manufactureditemdefinition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ManufacturedItemDefinition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ManufacturedItemDefinition.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.ManufacturedDoseForm" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "manufacturedDoseForm") }}</dd>
    {{~ if (fhir.exists resource "unitOfPresentation") ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.UnitOfPresentation" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "unitOfPresentation") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "manufacturer") ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.Manufacturer" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "manufacturer") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "ingredient") ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.Ingredient" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "ingredient") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "property") ~}}
    <dt>{{ l10n.t "ManufacturedItemDefinition.Property" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "property") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
