{{~ # Auto-generated Scriban narrative template for MedicationKnowledge ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MedicationKnowledge ~}}

<div class="fhir-narrative fhir-medicationknowledge" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "MedicationKnowledge.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "MedicationKnowledge.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "MedicationKnowledge.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "status") ~}}
    <dt>{{ l10n.t "MedicationKnowledge.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "MedicationKnowledge.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "MedicationKnowledge.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "manufacturer") ~}}
    <dt>{{ l10n.t "MedicationKnowledge.Manufacturer" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "manufacturer") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "amount") ~}}
    <dt>{{ l10n.t "MedicationKnowledge.Amount" }}</dt>
    <dd>{{ fhir.format_quantity (fhir.path resource "amount") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "synonym") ~}}
    <dt>{{ l10n.t "MedicationKnowledge.Synonym" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "synonym") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
