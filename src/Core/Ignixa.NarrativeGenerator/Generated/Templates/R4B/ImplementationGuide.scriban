{{~ # Auto-generated Scriban narrative template for ImplementationGuide ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ImplementationGuide ~}}

<div class="fhir-narrative fhir-implementationguide" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ImplementationGuide.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ImplementationGuide.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ImplementationGuide.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "ImplementationGuide.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ImplementationGuide.Url" }}</dt>
    <dd>{{ fhir.path resource "url" }}</dd>
    {{~ if (fhir.exists resource "version") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Version" }}</dt>
    <dd>{{ fhir.path resource "version" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "title") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Title" }}</dt>
    <dd>{{ fhir.path resource "title" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "experimental") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Experimental" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "experimental") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "publisher") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Publisher" }}</dt>
    <dd>{{ fhir.path resource "publisher" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "contact") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Contact" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "contact") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "useContext") ~}}
    <dt>{{ l10n.t "ImplementationGuide.UseContext" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "useContext") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "jurisdiction") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Jurisdiction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "jurisdiction") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ImplementationGuide.PackageId" }}</dt>
    <dd>{{ fhir.path resource "packageId" }}</dd>
    {{~ if (fhir.exists resource "license") ~}}
    <dt>{{ l10n.t "ImplementationGuide.License" }}</dt>
    <dd>{{ fhir.path resource "license" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ImplementationGuide.FhirVersion" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "fhirVersion") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ if (fhir.exists resource "dependsOn") ~}}
    <dt>{{ l10n.t "ImplementationGuide.DependsOn" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "dependsOn") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "global") ~}}
    <dt>{{ l10n.t "ImplementationGuide.Global" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "global") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
