{{~ # Auto-generated Scriban narrative template for Specimen ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Specimen ~}}

<div class="fhir-narrative fhir-specimen" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Specimen.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Specimen.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Specimen.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Specimen.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "status") ~}}
    <dt>{{ l10n.t "Specimen.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "Specimen.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Specimen.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "Specimen.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "accessionIdentifier") ~}}
    <dt>{{ l10n.t "Specimen.AccessionIdentifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "accessionIdentifier") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "Specimen.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "receivedTime") ~}}
    <dt>{{ l10n.t "Specimen.ReceivedTime" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "receivedTime") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "combined") ~}}
    <dt>{{ l10n.t "Specimen.Combined" }}</dt>
    <dd>{{ fhir.path resource "combined" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "condition") ~}}
    <dt>{{ l10n.t "Specimen.Condition" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "condition") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "Specimen.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
