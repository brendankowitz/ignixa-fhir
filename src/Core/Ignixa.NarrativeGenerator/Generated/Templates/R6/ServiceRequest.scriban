{{~ # Auto-generated Scriban narrative template for ServiceRequest ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ServiceRequest ~}}

<div class="fhir-narrative fhir-servicerequest" lang="{{ l10n.lang }}">
