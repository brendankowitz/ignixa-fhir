{{~ # Auto-generated Scriban narrative template for AppointmentResponse ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/AppointmentResponse ~}}

<div class="fhir-narrative fhir-appointmentresponse" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "AppointmentResponse.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "AppointmentResponse.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "AppointmentResponse.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "AppointmentResponse.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "AppointmentResponse.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "AppointmentResponse.Appointment" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "appointment") }}</dd>
    {{~ if (fhir.exists resource "proposedNewTime") ~}}
    <dt>{{ l10n.t "AppointmentResponse.ProposedNewTime" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "proposedNewTime") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "participantType") ~}}
    <dt>{{ l10n.t "AppointmentResponse.ParticipantType" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "participantType") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "actor") ~}}
    <dt>{{ l10n.t "AppointmentResponse.Actor" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "actor") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "AppointmentResponse.ParticipantStatus" }}</dt>
    <dd>{{ fhir.path resource "participantStatus" }}</dd>
  </dl>

</div>
