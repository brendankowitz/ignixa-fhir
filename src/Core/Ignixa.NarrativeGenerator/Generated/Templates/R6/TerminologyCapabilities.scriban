{{~ # Auto-generated Scriban narrative template for TerminologyCapabilities ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/TerminologyCapabilities ~}}

<div class="fhir-narrative fhir-terminologycapabilities" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "TerminologyCapabilities.Title" }}</h3>
