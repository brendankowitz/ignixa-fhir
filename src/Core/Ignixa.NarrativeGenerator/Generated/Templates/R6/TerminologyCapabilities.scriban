    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "jurisdiction") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "copyright") ~}}
    <dt>{{ l10n.t "TerminologyCapabilities.Copyright" }}</dt>
    <dd>{{ fhir.path resource "copyright" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "TerminologyCapabilities.Kind" }}</dt>
    <dd>{{ fhir.path resource "kind" }}</dd>
    {{~ if (fhir.exists resource "software") ~}}
    <dt>{{ l10n.t "TerminologyCapabilities.Software" }}</dt>
