{{~ # Auto-generated Scriban narrative template for EncounterHistory ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/EncounterHistory ~}}

<div class="fhir-narrative fhir-encounterhistory" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "EncounterHistory.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "EncounterHistory.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "EncounterHistory.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "EncounterHistory.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "EncounterHistory.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "EncounterHistory.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "EncounterHistory.Encounter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "encounter") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "EncounterHistory.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "EncounterHistory.Class" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "class") }}</dd>
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "EncounterHistory.Type" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "type") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "serviceType") ~}}
    <dt>{{ l10n.t "EncounterHistory.ServiceType" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "serviceType") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
