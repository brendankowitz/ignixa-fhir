{{~ # Auto-generated Scriban narrative template for NutritionIntake ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/NutritionIntake ~}}

<div class="fhir-narrative fhir-nutritionintake" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "NutritionIntake.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "NutritionIntake.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "NutritionIntake.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "NutritionIntake.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "NutritionIntake.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "NutritionIntake.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "NutritionIntake.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "NutritionIntake.Encounter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "encounter") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "performer") ~}}
    <dt>{{ l10n.t "NutritionIntake.Performer" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "performer") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recorded") ~}}
    <dt>{{ l10n.t "NutritionIntake.Recorded" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "recorded") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "NutritionIntake.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "NutritionIntake.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "basedOn") ~}}
    <dt>{{ l10n.t "NutritionIntake.BasedOn" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "basedOn") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "partOf") ~}}
    <dt>{{ l10n.t "NutritionIntake.PartOf" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "partOf") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "occurrence[x]") ~}}
    <dt>{{ l10n.t "NutritionIntake.Occurrence" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "occurrence[x]") }}</dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "NutritionIntake.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
