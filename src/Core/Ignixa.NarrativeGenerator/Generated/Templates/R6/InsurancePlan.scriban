{{~ # Auto-generated Scriban narrative template for InsurancePlan ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/InsurancePlan ~}}

<div class="fhir-narrative fhir-insuranceplan" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "InsurancePlan.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "InsurancePlan.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "InsurancePlan.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "InsurancePlan.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "InsurancePlan.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "product") ~}}
    <dt>{{ l10n.t "InsurancePlan.Product" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "product") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "coverageArea") ~}}
    <dt>{{ l10n.t "InsurancePlan.CoverageArea" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "coverageArea") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
