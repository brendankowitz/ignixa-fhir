{{~ # Auto-generated Scriban narrative template for ResearchStudy ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ResearchStudy ~}}

<div class="fhir-narrative fhir-researchstudy" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ResearchStudy.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ResearchStudy.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ResearchStudy.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ResearchStudy.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ResearchStudy.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "ResearchStudy.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "ResearchStudy.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ResearchStudy.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "ResearchStudy.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "ResearchStudy.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "title") ~}}
    <dt>{{ l10n.t "ResearchStudy.Title" }}</dt>
    <dd>{{ fhir.path resource "title" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "protocol") ~}}
    <dt>{{ l10n.t "ResearchStudy.Protocol" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "protocol") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "partOf") ~}}
    <dt>{{ l10n.t "ResearchStudy.PartOf" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "partOf") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "primaryPurposeType") ~}}
    <dt>{{ l10n.t "ResearchStudy.PrimaryPurposeType" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "primaryPurposeType") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "phase") ~}}
    <dt>{{ l10n.t "ResearchStudy.Phase" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "phase") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "studyDesign") ~}}
    <dt>{{ l10n.t "ResearchStudy.StudyDesign" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "studyDesign") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "condition") ~}}
    <dt>{{ l10n.t "ResearchStudy.Condition" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "condition") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "keyword") ~}}
    <dt>{{ l10n.t "ResearchStudy.Keyword" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "keyword") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "region") ~}}
    <dt>{{ l10n.t "ResearchStudy.Region" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "region") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "period") ~}}
    <dt>{{ l10n.t "ResearchStudy.Period" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "period") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "site") ~}}
    <dt>{{ l10n.t "ResearchStudy.Site" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "site") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "whyStopped") ~}}
    <dt>{{ l10n.t "ResearchStudy.WhyStopped" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "whyStopped") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recruitment") ~}}
    <dt>{{ l10n.t "ResearchStudy.Recruitment" }}</dt>
    <dd>{{ fhir.path resource "recruitment" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "result") ~}}
    <dt>{{ l10n.t "ResearchStudy.Result" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "result") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "ResearchStudy.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
