    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "FamilyMemberHistory.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "instantiatesCanonical") ~}}
    <dt>{{ l10n.t "FamilyMemberHistory.InstantiatesCanonical" }}</dt>
    <dd>
