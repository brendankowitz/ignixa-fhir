{{~ # Auto-generated Scriban narrative template for FamilyMemberHistory ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/FamilyMemberHistory ~}}

<div class="fhir-narrative fhir-familymemberhistory" lang="{{ l10n.lang }}">
  <header class="fhir-header">
