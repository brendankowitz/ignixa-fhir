    <dt>{{ l10n.t "FamilyMemberHistory.DataAbsentReason" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "dataAbsentReason") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "participant") ~}}
    <dt>{{ l10n.t "FamilyMemberHistory.Participant" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "participant") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "FamilyMemberHistory.Relationship" }}</dt>
