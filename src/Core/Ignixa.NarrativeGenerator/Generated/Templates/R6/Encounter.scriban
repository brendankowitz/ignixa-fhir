{{~ # Auto-generated Scriban narrative template for Encounter ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Encounter ~}}

<div class="fhir-narrative fhir-encounter" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Encounter.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Encounter.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Encounter.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Encounter.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Encounter.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "Encounter.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Encounter.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "class") ~}}
    <dt>{{ l10n.t "Encounter.Class" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "class") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "Encounter.Type" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "type") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "serviceType") ~}}
    <dt>{{ l10n.t "Encounter.ServiceType" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "serviceType") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "episodeOfCare") ~}}
    <dt>{{ l10n.t "Encounter.EpisodeOfCare" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "episodeOfCare") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "participant") ~}}
    <dt>{{ l10n.t "Encounter.Participant" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "participant") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "appointment") ~}}
    <dt>{{ l10n.t "Encounter.Appointment" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "appointment") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "reason") ~}}
    <dt>{{ l10n.t "Encounter.Reason" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "reason") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "diagnosis") ~}}
    <dt>{{ l10n.t "Encounter.Diagnosis" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "diagnosis") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
