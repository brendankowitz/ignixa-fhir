{{~ # Auto-generated Scriban narrative template for PaymentReconciliation ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/PaymentReconciliation ~}}

<div class="fhir-narrative fhir-paymentreconciliation" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "PaymentReconciliation.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "PaymentReconciliation.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "PaymentReconciliation.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "PaymentReconciliation.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "PaymentReconciliation.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "PaymentReconciliation.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "PaymentReconciliation.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "PaymentReconciliation.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    {{~ if (fhir.exists resource "period") ~}}
    <dt>{{ l10n.t "PaymentReconciliation.Period" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "period") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "PaymentReconciliation.Created" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "created") }}</dd>
    {{~ if (fhir.exists resource "paymentIssuer") ~}}
    <dt>{{ l10n.t "PaymentReconciliation.PaymentIssuer" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "paymentIssuer") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "PaymentReconciliation.Amount" }}</dt>
    <dd>{{ fhir.path resource "amount" }}</dd>
  </dl>

</div>
