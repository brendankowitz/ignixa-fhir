{{~ # Auto-generated Scriban narrative template for InsuranceProduct ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/InsuranceProduct ~}}

<div class="fhir-narrative fhir-insuranceproduct" lang="{{ l10n.lang }}">
  <header class="fhir-header">
