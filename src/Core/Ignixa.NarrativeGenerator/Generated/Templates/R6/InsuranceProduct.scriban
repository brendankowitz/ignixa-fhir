    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "InsuranceProduct.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "InsuranceProduct.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "status") ~}}
    <dt>{{ l10n.t "InsuranceProduct.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "InsuranceProduct.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "InsuranceProduct.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "InsuranceProduct.Type" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "type") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "ownedBy") ~}}
    <dt>{{ l10n.t "InsuranceProduct.OwnedBy" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "ownedBy") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "administeredBy") ~}}
    <dt>{{ l10n.t "InsuranceProduct.AdministeredBy" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "administeredBy") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "coverageArea") ~}}
    <dt>{{ l10n.t "InsuranceProduct.CoverageArea" }}</dt>
    <dd>
      <ul class="fhir-list">
