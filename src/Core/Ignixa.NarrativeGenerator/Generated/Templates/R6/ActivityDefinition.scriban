    {{~ if (fhir.exists resource "kind") ~}}
    <dt>{{ l10n.t "ActivityDefinition.Kind" }}</dt>
    <dd>{{ fhir.path resource "kind" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "doNotPerform") ~}}
    <dt>{{ l10n.t "ActivityDefinition.DoNotPerform" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "doNotPerform") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "asNeeded[x]") ~}}
    <dt>{{ l10n.t "ActivityDefinition.AsNeeded" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "asNeeded[x]") }}</dd>
    {{~ end ~}}
