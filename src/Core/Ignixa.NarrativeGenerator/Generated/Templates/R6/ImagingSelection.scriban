{{~ # Auto-generated Scriban narrative template for ImagingSelection ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ImagingSelection ~}}

<div class="fhir-narrative fhir-imagingselection" lang="{{ l10n.lang }}">
