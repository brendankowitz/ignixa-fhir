{{~ # Auto-generated Scriban narrative template for Measure ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Measure ~}}

<div class="fhir-narrative fhir-measure" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Measure.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Measure.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Measure.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Measure.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Measure.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "Measure.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "author") ~}}
    <dt>{{ l10n.t "Measure.Author" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "author") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "Measure.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "effectivePeriod") ~}}
    <dt>{{ l10n.t "Measure.EffectivePeriod" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "effectivePeriod") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Measure.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "Measure.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "url") ~}}
    <dt>{{ l10n.t "Measure.Url" }}</dt>
    <dd>{{ fhir.path resource "url" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "version") ~}}
    <dt>{{ l10n.t "Measure.Version" }}</dt>
    <dd>{{ fhir.path resource "version" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "versionAlgorithm[x]") ~}}
    <dt>{{ l10n.t "Measure.VersionAlgorithm" }}</dt>
    <dd>{{ fhir.path resource "versionAlgorithm[x]" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "title") ~}}
    <dt>{{ l10n.t "Measure.Title" }}</dt>
    <dd>{{ fhir.path resource "title" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "experimental") ~}}
    <dt>{{ l10n.t "Measure.Experimental" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "experimental") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "basis") ~}}
    <dt>{{ l10n.t "Measure.Basis" }}</dt>
    <dd>{{ fhir.path resource "basis" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "publisher") ~}}
    <dt>{{ l10n.t "Measure.Publisher" }}</dt>
    <dd>{{ fhir.path resource "publisher" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "contact") ~}}
    <dt>{{ l10n.t "Measure.Contact" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "contact") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "useContext") ~}}
    <dt>{{ l10n.t "Measure.UseContext" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "useContext") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "jurisdiction") ~}}
    <dt>{{ l10n.t "Measure.Jurisdiction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "jurisdiction") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "disclaimer") ~}}
    <dt>{{ l10n.t "Measure.Disclaimer" }}</dt>
    <dd>{{ fhir.path resource "disclaimer" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "scoring") ~}}
    <dt>{{ l10n.t "Measure.Scoring" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "scoring") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "scoringUnit") ~}}
    <dt>{{ l10n.t "Measure.ScoringUnit" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "scoringUnit") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "compositeScoring") ~}}
    <dt>{{ l10n.t "Measure.CompositeScoring" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "compositeScoring") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "Measure.Type" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "type") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "riskAdjustment") ~}}
    <dt>{{ l10n.t "Measure.RiskAdjustment" }}</dt>
    <dd>{{ fhir.path resource "riskAdjustment" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "rateAggregation") ~}}
    <dt>{{ l10n.t "Measure.RateAggregation" }}</dt>
    <dd>{{ fhir.path resource "rateAggregation" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "rationale") ~}}
    <dt>{{ l10n.t "Measure.Rationale" }}</dt>
    <dd>{{ fhir.path resource "rationale" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "clinicalRecommendationStatement") ~}}
    <dt>{{ l10n.t "Measure.ClinicalRecommendationStatement" }}</dt>
    <dd>{{ fhir.path resource "clinicalRecommendationStatement" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "improvementNotation") ~}}
    <dt>{{ l10n.t "Measure.ImprovementNotation" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "improvementNotation") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "guidance") ~}}
    <dt>{{ l10n.t "Measure.Guidance" }}</dt>
    <dd>{{ fhir.path resource "guidance" }}</dd>
    {{~ end ~}}
  </dl>

</div>
