{{~ # Auto-generated Scriban narrative template for DeviceAssociation ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/DeviceAssociation ~}}

<div class="fhir-narrative fhir-deviceassociation" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "DeviceAssociation.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "DeviceAssociation.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "DeviceAssociation.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "DeviceAssociation.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DeviceAssociation.Status" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "status") }}</dd>
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "DeviceAssociation.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "DeviceAssociation.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "DeviceAssociation.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DeviceAssociation.Device" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "device") }}</dd>
  </dl>

</div>
