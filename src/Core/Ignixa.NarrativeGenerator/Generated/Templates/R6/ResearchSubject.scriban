{{~ # Auto-generated Scriban narrative template for ResearchSubject ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ResearchSubject ~}}

<div class="fhir-narrative fhir-researchsubject" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ResearchSubject.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ResearchSubject.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ResearchSubject.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ResearchSubject.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ResearchSubject.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "ResearchSubject.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ResearchSubject.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "period") ~}}
    <dt>{{ l10n.t "ResearchSubject.Period" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "period") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ResearchSubject.Study" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "study") }}</dd>
  </dl>

</div>
