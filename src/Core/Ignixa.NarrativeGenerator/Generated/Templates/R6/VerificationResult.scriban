{{~ # Auto-generated Scriban narrative template for VerificationResult ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/VerificationResult ~}}

<div class="fhir-narrative fhir-verificationresult" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "VerificationResult.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "VerificationResult.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "VerificationResult.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "VerificationResult.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "VerificationResult.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "target") ~}}
    <dt>{{ l10n.t "VerificationResult.Target" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "target") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "targetLocation") ~}}
    <dt>{{ l10n.t "VerificationResult.TargetLocation" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "targetLocation") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "need") ~}}
    <dt>{{ l10n.t "VerificationResult.Need" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "need") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "statusDate") ~}}
    <dt>{{ l10n.t "VerificationResult.StatusDate" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "statusDate") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "validationType") ~}}
    <dt>{{ l10n.t "VerificationResult.ValidationType" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "validationType") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "validationProcess") ~}}
    <dt>{{ l10n.t "VerificationResult.ValidationProcess" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "validationProcess") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "failureAction") ~}}
    <dt>{{ l10n.t "VerificationResult.FailureAction" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "failureAction") }}</dd>
    {{~ end ~}}
  </dl>

</div>
