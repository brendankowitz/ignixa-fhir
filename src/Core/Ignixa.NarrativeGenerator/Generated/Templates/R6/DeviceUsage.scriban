{{~ # Auto-generated Scriban narrative template for DeviceUsage ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/DeviceUsage ~}}

<div class="fhir-narrative fhir-deviceusage" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "DeviceUsage.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "DeviceUsage.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "DeviceUsage.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "DeviceUsage.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DeviceUsage.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "DeviceUsage.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "DeviceUsage.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "bodySite") ~}}
    <dt>{{ l10n.t "DeviceUsage.BodySite" }}</dt>
    <dd>{{ fhir.path resource "bodySite" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "DeviceUsage.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "DeviceUsage.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "basedOn") ~}}
    <dt>{{ l10n.t "DeviceUsage.BasedOn" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "basedOn") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "derivedFrom") ~}}
    <dt>{{ l10n.t "DeviceUsage.DerivedFrom" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "derivedFrom") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "context") ~}}
    <dt>{{ l10n.t "DeviceUsage.Context" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "context") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "timing[x]") ~}}
    <dt>{{ l10n.t "DeviceUsage.Timing" }}</dt>
    <dd>{{ fhir.path resource "timing[x]" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "dateAsserted") ~}}
    <dt>{{ l10n.t "DeviceUsage.DateAsserted" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "dateAsserted") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "informationSource") ~}}
    <dt>{{ l10n.t "DeviceUsage.InformationSource" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "informationSource") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DeviceUsage.Device" }}</dt>
    <dd>{{ fhir.path resource "device" }}</dd>
    {{~ if (fhir.exists resource "reason") ~}}
    <dt>{{ l10n.t "DeviceUsage.Reason" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "reason") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "DeviceUsage.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
