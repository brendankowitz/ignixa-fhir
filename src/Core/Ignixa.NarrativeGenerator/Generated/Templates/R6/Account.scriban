{{~ # Auto-generated Scriban narrative template for Account ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Account ~}}

<div class="fhir-narrative fhir-account" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Account.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Account.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Account.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Account.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Account.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "Account.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "Account.Subject" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "subject") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Account.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "Account.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "billingStatus") ~}}
    <dt>{{ l10n.t "Account.BillingStatus" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "billingStatus") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "Account.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "servicePeriod") ~}}
    <dt>{{ l10n.t "Account.ServicePeriod" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "servicePeriod") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "covers") ~}}
    <dt>{{ l10n.t "Account.Covers" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "covers") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "coverage") ~}}
    <dt>{{ l10n.t "Account.Coverage" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "coverage") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "owner") ~}}
    <dt>{{ l10n.t "Account.Owner" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "owner") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "diagnosis") ~}}
    <dt>{{ l10n.t "Account.Diagnosis" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "diagnosis") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "procedure") ~}}
    <dt>{{ l10n.t "Account.Procedure" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "procedure") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
