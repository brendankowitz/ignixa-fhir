{{~ # Auto-generated Scriban narrative template for Schedule ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Schedule ~}}

<div class="fhir-narrative fhir-schedule" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Schedule.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Schedule.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Schedule.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Schedule.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "Schedule.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Schedule.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "active") ~}}
    <dt>{{ l10n.t "Schedule.Active" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "active") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "serviceCategory") ~}}
    <dt>{{ l10n.t "Schedule.ServiceCategory" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "serviceCategory") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "serviceType") ~}}
    <dt>{{ l10n.t "Schedule.ServiceType" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "serviceType") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "specialty") ~}}
    <dt>{{ l10n.t "Schedule.Specialty" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "specialty") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Schedule.Actor" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "actor") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ if (fhir.exists resource "planningHorizon") ~}}
    <dt>{{ l10n.t "Schedule.PlanningHorizon" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "planningHorizon") }}</dd>
    {{~ end ~}}
  </dl>

</div>
