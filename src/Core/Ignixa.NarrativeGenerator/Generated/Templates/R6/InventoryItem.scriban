{{~ # Auto-generated Scriban narrative template for InventoryItem ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/InventoryItem ~}}

<div class="fhir-narrative fhir-inventoryitem" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "InventoryItem.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "InventoryItem.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "InventoryItem.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "InventoryItem.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "InventoryItem.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "InventoryItem.Name" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "name") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "InventoryItem.Code" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "code") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "InventoryItem.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "InventoryItem.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "InventoryItem.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "inventoryStatus") ~}}
    <dt>{{ l10n.t "InventoryItem.InventoryStatus" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "inventoryStatus") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "baseUnit") ~}}
    <dt>{{ l10n.t "InventoryItem.BaseUnit" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "baseUnit") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "netContent") ~}}
    <dt>{{ l10n.t "InventoryItem.NetContent" }}</dt>
    <dd>{{ fhir.format_quantity (fhir.path resource "netContent") }}</dd>
    {{~ end ~}}
  </dl>

</div>
