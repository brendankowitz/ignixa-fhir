{{~ # Auto-generated Scriban narrative template for MedicationAdministration ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MedicationAdministration ~}}

<div class="fhir-narrative fhir-medicationadministration" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "MedicationAdministration.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "MedicationAdministration.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "MedicationAdministration.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "MedicationAdministration.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicationAdministration.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "MedicationAdministration.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "MedicationAdministration.Encounter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "encounter") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "performer") ~}}
    <dt>{{ l10n.t "MedicationAdministration.Performer" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "performer") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recorded") ~}}
    <dt>{{ l10n.t "MedicationAdministration.Recorded" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "recorded") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "MedicationAdministration.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "MedicationAdministration.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "MedicationAdministration.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "partOf") ~}}
    <dt>{{ l10n.t "MedicationAdministration.PartOf" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "partOf") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicationAdministration.Medication" }}</dt>
    <dd>{{ fhir.path resource "medication" }}</dd>
    <dt>{{ l10n.t "MedicationAdministration.Occurrence" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "occurrence[x]") }}</dd>
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "MedicationAdministration.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
