{{~ # Auto-generated Scriban narrative template for Slot ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Slot ~}}

<div class="fhir-narrative fhir-slot" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Slot.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Slot.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Slot.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Slot.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Slot.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Slot.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "serviceCategory") ~}}
    <dt>{{ l10n.t "Slot.ServiceCategory" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "serviceCategory") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "serviceType") ~}}
    <dt>{{ l10n.t "Slot.ServiceType" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "serviceType") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "specialty") ~}}
    <dt>{{ l10n.t "Slot.Specialty" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "specialty") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "appointmentType") ~}}
    <dt>{{ l10n.t "Slot.AppointmentType" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "appointmentType") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Slot.Schedule" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "schedule") }}</dd>
    <dt>{{ l10n.t "Slot.Start" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "start") }}</dd>
    <dt>{{ l10n.t "Slot.End" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "end") }}</dd>
  </dl>

</div>
