{{~ # Auto-generated Scriban narrative template for DocumentManifest ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/DocumentManifest ~}}

<div class="fhir-narrative fhir-documentmanifest" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "DocumentManifest.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "DocumentManifest.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "DocumentManifest.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "DocumentManifest.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DocumentManifest.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "DocumentManifest.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "author") ~}}
    <dt>{{ l10n.t "DocumentManifest.Author" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "author") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "DocumentManifest.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "DocumentManifest.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "masterIdentifier") ~}}
    <dt>{{ l10n.t "DocumentManifest.MasterIdentifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "masterIdentifier") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "DocumentManifest.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "created") ~}}
    <dt>{{ l10n.t "DocumentManifest.Created" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "created") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recipient") ~}}
    <dt>{{ l10n.t "DocumentManifest.Recipient" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "recipient") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "source") ~}}
    <dt>{{ l10n.t "DocumentManifest.Source" }}</dt>
    <dd>{{ fhir.path resource "source" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DocumentManifest.Content" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "content") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ if (fhir.exists resource "related") ~}}
    <dt>{{ l10n.t "DocumentManifest.Related" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "related") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
