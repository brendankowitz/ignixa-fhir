{{~ # Auto-generated Scriban narrative template for ImagingManifest ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ImagingManifest ~}}

<div class="fhir-narrative fhir-imagingmanifest" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ImagingManifest.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ImagingManifest.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ImagingManifest.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ImagingManifest.Identifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "identifier") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ImagingManifest.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ if (fhir.exists resource "author") ~}}
    <dt>{{ l10n.t "ImagingManifest.Author" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "author") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ImagingManifest.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "ImagingManifest.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "authoringTime") ~}}
    <dt>{{ l10n.t "ImagingManifest.AuthoringTime" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "authoringTime") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ImagingManifest.Study" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "study") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
  </dl>

</div>
