{{~ # Auto-generated Scriban narrative template for Medication ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Medication ~}}

<div class="fhir-narrative fhir-medication" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Medication.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Medication.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Medication.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "status") ~}}
    <dt>{{ l10n.t "Medication.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "Medication.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Medication.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "isBrand") ~}}
    <dt>{{ l10n.t "Medication.IsBrand" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "isBrand") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "isOverTheCounter") ~}}
    <dt>{{ l10n.t "Medication.IsOverTheCounter" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "isOverTheCounter") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "manufacturer") ~}}
    <dt>{{ l10n.t "Medication.Manufacturer" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "manufacturer") }}</dd>
    {{~ end ~}}
  </dl>

</div>
