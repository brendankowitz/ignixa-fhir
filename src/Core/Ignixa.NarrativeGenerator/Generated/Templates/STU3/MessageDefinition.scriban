{{~ # Auto-generated Scriban narrative template for MessageDefinition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MessageDefinition ~}}

<div class="fhir-narrative fhir-messagedefinition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "MessageDefinition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "MessageDefinition.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "MessageDefinition.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "MessageDefinition.Identifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "identifier") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MessageDefinition.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "MessageDefinition.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MessageDefinition.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "MessageDefinition.Category" }}</dt>
    <dd>{{ fhir.path resource "category" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "MessageDefinition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "MessageDefinition.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "url") ~}}
    <dt>{{ l10n.t "MessageDefinition.Url" }}</dt>
    <dd>{{ fhir.path resource "url" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "version") ~}}
    <dt>{{ l10n.t "MessageDefinition.Version" }}</dt>
    <dd>{{ fhir.path resource "version" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "title") ~}}
    <dt>{{ l10n.t "MessageDefinition.Title" }}</dt>
    <dd>{{ fhir.path resource "title" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "experimental") ~}}
    <dt>{{ l10n.t "MessageDefinition.Experimental" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "experimental") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "publisher") ~}}
    <dt>{{ l10n.t "MessageDefinition.Publisher" }}</dt>
    <dd>{{ fhir.path resource "publisher" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "contact") ~}}
    <dt>{{ l10n.t "MessageDefinition.Contact" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "contact") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "useContext") ~}}
    <dt>{{ l10n.t "MessageDefinition.UseContext" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "useContext") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "jurisdiction") ~}}
    <dt>{{ l10n.t "MessageDefinition.Jurisdiction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "jurisdiction") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "purpose") ~}}
    <dt>{{ l10n.t "MessageDefinition.Purpose" }}</dt>
    <dd>{{ fhir.path resource "purpose" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "base") ~}}
    <dt>{{ l10n.t "MessageDefinition.Base" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "base") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "parent") ~}}
    <dt>{{ l10n.t "MessageDefinition.Parent" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "parent") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "replaces") ~}}
    <dt>{{ l10n.t "MessageDefinition.Replaces" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "replaces") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MessageDefinition.Event" }}</dt>
    <dd>{{ fhir.display_coding (fhir.path resource "event") }}</dd>
    {{~ if (fhir.exists resource "focus") ~}}
    <dt>{{ l10n.t "MessageDefinition.Focus" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "focus") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
