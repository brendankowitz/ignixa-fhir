{{~ # Auto-generated Scriban narrative template for Consent ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Consent ~}}

<div class="fhir-narrative fhir-consent" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Consent.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Consent.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Consent.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Consent.Identifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "identifier") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Consent.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "Consent.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ if (fhir.exists resource "dateTime") ~}}
    <dt>{{ l10n.t "Consent.DateTime" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "dateTime") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "Consent.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Consent.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "period") ~}}
    <dt>{{ l10n.t "Consent.Period" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "period") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "consentingParty") ~}}
    <dt>{{ l10n.t "Consent.ConsentingParty" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "consentingParty") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "actor") ~}}
    <dt>{{ l10n.t "Consent.Actor" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "actor") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "action") ~}}
    <dt>{{ l10n.t "Consent.Action" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "action") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "organization") ~}}
    <dt>{{ l10n.t "Consent.Organization" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "organization") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "source[x]") ~}}
    <dt>{{ l10n.t "Consent.Source" }}</dt>
    <dd>{{ fhir.path resource "source[x]" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "policyRule") ~}}
    <dt>{{ l10n.t "Consent.PolicyRule" }}</dt>
    <dd>{{ fhir.path resource "policyRule" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "securityLabel") ~}}
    <dt>{{ l10n.t "Consent.SecurityLabel" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "securityLabel") ~}}
        <li>{{ fhir.display_coding item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "purpose") ~}}
    <dt>{{ l10n.t "Consent.Purpose" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "purpose") ~}}
        <li>{{ fhir.display_coding item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "dataPeriod") ~}}
    <dt>{{ l10n.t "Consent.DataPeriod" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "dataPeriod") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "data") ~}}
    <dt>{{ l10n.t "Consent.Data" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "data") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "except") ~}}
    <dt>{{ l10n.t "Consent.Except" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "except") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
