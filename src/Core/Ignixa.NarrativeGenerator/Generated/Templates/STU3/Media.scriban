{{~ # Auto-generated Scriban narrative template for Media ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Media ~}}

<div class="fhir-narrative fhir-media" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Media.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Media.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Media.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Media.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "Media.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "bodySite") ~}}
    <dt>{{ l10n.t "Media.BodySite" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "bodySite") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Media.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "Media.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "basedOn") ~}}
    <dt>{{ l10n.t "Media.BasedOn" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "basedOn") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Media.Type" }}</dt>
    <dd>{{ fhir.path resource "type" }}</dd>
    {{~ if (fhir.exists resource "subtype") ~}}
    <dt>{{ l10n.t "Media.Subtype" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "subtype") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "view") ~}}
    <dt>{{ l10n.t "Media.View" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "view") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "context") ~}}
    <dt>{{ l10n.t "Media.Context" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "context") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "occurrence[x]") ~}}
    <dt>{{ l10n.t "Media.Occurrence" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "occurrence[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "operator") ~}}
    <dt>{{ l10n.t "Media.Operator" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "operator") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "reasonCode") ~}}
    <dt>{{ l10n.t "Media.ReasonCode" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "reasonCode") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "device") ~}}
    <dt>{{ l10n.t "Media.Device" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "device") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "height") ~}}
    <dt>{{ l10n.t "Media.Height" }}</dt>
    <dd>{{ fhir.path resource "height" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "width") ~}}
    <dt>{{ l10n.t "Media.Width" }}</dt>
    <dd>{{ fhir.path resource "width" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "frames") ~}}
    <dt>{{ l10n.t "Media.Frames" }}</dt>
    <dd>{{ fhir.path resource "frames" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "duration") ~}}
    <dt>{{ l10n.t "Media.Duration" }}</dt>
    <dd>{{ fhir.path resource "duration" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Media.Content" }}</dt>
    <dd>{{ fhir.path resource "content" }}</dd>
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "Media.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
