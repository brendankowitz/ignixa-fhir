    {{~ end ~}}
    {{~ if (fhir.exists resource "excludeNotForUI") ~}}
    <dt>{{ l10n.t "ExpansionProfile.ExcludeNotForUI" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "excludeNotForUI") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "excludePostCoordinated") ~}}
    <dt>{{ l10n.t "ExpansionProfile.ExcludePostCoordinated" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "excludePostCoordinated") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "displayLanguage") ~}}
    <dt>{{ l10n.t "ExpansionProfile.DisplayLanguage" }}</dt>
    <dd>{{ fhir.path resource "displayLanguage" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "limitedExpansion") ~}}
