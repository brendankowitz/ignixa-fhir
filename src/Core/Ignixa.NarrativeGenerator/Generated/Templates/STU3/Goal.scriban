{{~ # Auto-generated Scriban narrative template for Goal ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Goal ~}}

<div class="fhir-narrative fhir-goal" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Goal.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Goal.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Goal.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Goal.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Goal.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "Goal.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "Goal.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Goal.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Goal.Description" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "description") }}</dd>
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "Goal.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "priority") ~}}
    <dt>{{ l10n.t "Goal.Priority" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "priority") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "start[x]") ~}}
    <dt>{{ l10n.t "Goal.Start" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "start[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "statusDate") ~}}
    <dt>{{ l10n.t "Goal.StatusDate" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "statusDate") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "expressedBy") ~}}
    <dt>{{ l10n.t "Goal.ExpressedBy" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "expressedBy") }}</dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "Goal.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
