{{~ # Auto-generated Scriban narrative template for DeviceComponent ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/DeviceComponent ~}}

<div class="fhir-narrative fhir-devicecomponent" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "DeviceComponent.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "DeviceComponent.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "DeviceComponent.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DeviceComponent.Identifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "identifier") }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "DeviceComponent.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DeviceComponent.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    {{~ if (fhir.exists resource "lastSystemChange") ~}}
    <dt>{{ l10n.t "DeviceComponent.LastSystemChange" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "lastSystemChange") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "source") ~}}
    <dt>{{ l10n.t "DeviceComponent.Source" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "source") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "parent") ~}}
    <dt>{{ l10n.t "DeviceComponent.Parent" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "parent") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "operationalStatus") ~}}
    <dt>{{ l10n.t "DeviceComponent.OperationalStatus" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "operationalStatus") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "parameterGroup") ~}}
    <dt>{{ l10n.t "DeviceComponent.ParameterGroup" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "parameterGroup") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "measurementPrinciple") ~}}
    <dt>{{ l10n.t "DeviceComponent.MeasurementPrinciple" }}</dt>
    <dd>{{ fhir.path resource "measurementPrinciple" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "productionSpecification") ~}}
    <dt>{{ l10n.t "DeviceComponent.ProductionSpecification" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "productionSpecification") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "languageCode") ~}}
    <dt>{{ l10n.t "DeviceComponent.LanguageCode" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "languageCode") }}</dd>
    {{~ end ~}}
  </dl>

</div>
