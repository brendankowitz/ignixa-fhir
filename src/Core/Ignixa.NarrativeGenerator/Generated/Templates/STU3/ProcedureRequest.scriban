{{~ # Auto-generated Scriban narrative template for ProcedureRequest ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ProcedureRequest ~}}

<div class="fhir-narrative fhir-procedurerequest" lang="{{ l10n.lang }}">
