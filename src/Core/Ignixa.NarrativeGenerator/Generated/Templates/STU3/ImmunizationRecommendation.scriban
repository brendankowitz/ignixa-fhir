{{~ # Auto-generated Scriban narrative template for ImmunizationRecommendation ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ImmunizationRecommendation ~}}

<div class="fhir-narrative fhir-immunizationrecommendation" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ImmunizationRecommendation.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ImmunizationRecommendation.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ImmunizationRecommendation.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ImmunizationRecommendation.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ImmunizationRecommendation.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ImmunizationRecommendation.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ImmunizationRecommendation.Recommendation" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "recommendation") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
  </dl>

</div>
