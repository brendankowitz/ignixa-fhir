{{~ # Auto-generated Scriban narrative template for AdverseEvent ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/AdverseEvent ~}}

<div class="fhir-narrative fhir-adverseevent" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "AdverseEvent.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "AdverseEvent.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "AdverseEvent.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "AdverseEvent.Identifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "identifier") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "AdverseEvent.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "AdverseEvent.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "AdverseEvent.Category" }}</dt>
    <dd>{{ fhir.path resource "category" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "AdverseEvent.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "AdverseEvent.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "AdverseEvent.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "reaction") ~}}
    <dt>{{ l10n.t "AdverseEvent.Reaction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "reaction") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "location") ~}}
    <dt>{{ l10n.t "AdverseEvent.Location" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "location") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "seriousness") ~}}
    <dt>{{ l10n.t "AdverseEvent.Seriousness" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "seriousness") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "outcome") ~}}
    <dt>{{ l10n.t "AdverseEvent.Outcome" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "outcome") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recorder") ~}}
    <dt>{{ l10n.t "AdverseEvent.Recorder" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "recorder") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "eventParticipant") ~}}
    <dt>{{ l10n.t "AdverseEvent.EventParticipant" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "eventParticipant") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "suspectEntity") ~}}
    <dt>{{ l10n.t "AdverseEvent.SuspectEntity" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "suspectEntity") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subjectMedicalHistory") ~}}
    <dt>{{ l10n.t "AdverseEvent.SubjectMedicalHistory" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "subjectMedicalHistory") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "referenceDocument") ~}}
    <dt>{{ l10n.t "AdverseEvent.ReferenceDocument" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "referenceDocument") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "study") ~}}
    <dt>{{ l10n.t "AdverseEvent.Study" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "study") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
