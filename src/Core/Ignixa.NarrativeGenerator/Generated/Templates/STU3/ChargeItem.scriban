{{~ # Auto-generated Scriban narrative template for ChargeItem ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ChargeItem ~}}

<div class="fhir-narrative fhir-chargeitem" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ChargeItem.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ChargeItem.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ChargeItem.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ChargeItem.Identifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "identifier") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ChargeItem.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "ChargeItem.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    <dt>{{ l10n.t "ChargeItem.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ if (fhir.exists resource "bodysite") ~}}
    <dt>{{ l10n.t "ChargeItem.Bodysite" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "bodysite") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ChargeItem.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "ChargeItem.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "context") ~}}
    <dt>{{ l10n.t "ChargeItem.Context" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "context") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "occurrence[x]") ~}}
    <dt>{{ l10n.t "ChargeItem.Occurrence" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "occurrence[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "quantity") ~}}
    <dt>{{ l10n.t "ChargeItem.Quantity" }}</dt>
    <dd>{{ fhir.format_quantity (fhir.path resource "quantity") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "bodysite") ~}}
    <dt>{{ l10n.t "ChargeItem.Bodysite" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "bodysite") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "enterer") ~}}
    <dt>{{ l10n.t "ChargeItem.Enterer" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "enterer") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "enteredDate") ~}}
    <dt>{{ l10n.t "ChargeItem.EnteredDate" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "enteredDate") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "account") ~}}
    <dt>{{ l10n.t "ChargeItem.Account" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "account") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "ChargeItem.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
