{{~ # Auto-generated Scriban narrative template for Invoice ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Invoice ~}}

<div class="fhir-narrative fhir-invoice" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Invoice.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Invoice.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Invoice.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Invoice.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Invoice.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "Invoice.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "Invoice.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Invoice.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "Invoice.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "Invoice.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recipient") ~}}
    <dt>{{ l10n.t "Invoice.Recipient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "recipient") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "creation") ~}}
    <dt>{{ l10n.t "Invoice.Creation" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "creation") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "period[x]") ~}}
    <dt>{{ l10n.t "Invoice.Period" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "period[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "totalNet") ~}}
    <dt>{{ l10n.t "Invoice.TotalNet" }}</dt>
    <dd>{{ fhir.path resource "totalNet" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "totalGross") ~}}
    <dt>{{ l10n.t "Invoice.TotalGross" }}</dt>
    <dd>{{ fhir.path resource "totalGross" }}</dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "Invoice.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
