{{~ # Auto-generated Scriban narrative template for ConceptMap ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ConceptMap ~}}

<div class="fhir-narrative fhir-conceptmap" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ConceptMap.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ConceptMap.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ConceptMap.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ConceptMap.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ConceptMap.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "ConceptMap.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "author") ~}}
    <dt>{{ l10n.t "ConceptMap.Author" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "author") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "ConceptMap.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "effectivePeriod") ~}}
    <dt>{{ l10n.t "ConceptMap.EffectivePeriod" }}</dt>
    <dd>{{ fhir.format_period (fhir.path resource "effectivePeriod") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ConceptMap.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "ConceptMap.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "url") ~}}
    <dt>{{ l10n.t "ConceptMap.Url" }}</dt>
    <dd>{{ fhir.path resource "url" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "version") ~}}
    <dt>{{ l10n.t "ConceptMap.Version" }}</dt>
    <dd>{{ fhir.path resource "version" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "versionAlgorithm[x]") ~}}
    <dt>{{ l10n.t "ConceptMap.VersionAlgorithm" }}</dt>
    <dd>{{ fhir.path resource "versionAlgorithm[x]" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "title") ~}}
    <dt>{{ l10n.t "ConceptMap.Title" }}</dt>
    <dd>{{ fhir.path resource "title" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "experimental") ~}}
    <dt>{{ l10n.t "ConceptMap.Experimental" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "experimental") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "publisher") ~}}
    <dt>{{ l10n.t "ConceptMap.Publisher" }}</dt>
    <dd>{{ fhir.path resource "publisher" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "contact") ~}}
    <dt>{{ l10n.t "ConceptMap.Contact" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "contact") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "useContext") ~}}
    <dt>{{ l10n.t "ConceptMap.UseContext" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "useContext") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "jurisdiction") ~}}
    <dt>{{ l10n.t "ConceptMap.Jurisdiction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "jurisdiction") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "property") ~}}
    <dt>{{ l10n.t "ConceptMap.Property" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "property") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "additionalAttribute") ~}}
    <dt>{{ l10n.t "ConceptMap.AdditionalAttribute" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "additionalAttribute") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "sourceScope[x]") ~}}
    <dt>{{ l10n.t "ConceptMap.SourceScope" }}</dt>
    <dd>{{ fhir.path resource "sourceScope[x]" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "targetScope[x]") ~}}
    <dt>{{ l10n.t "ConceptMap.TargetScope" }}</dt>
    <dd>{{ fhir.path resource "targetScope[x]" }}</dd>
    {{~ end ~}}
  </dl>

</div>
