{{~ # Auto-generated Scriban narrative template for MolecularSequence ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MolecularSequence ~}}

<div class="fhir-narrative fhir-molecularsequence" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "MolecularSequence.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "MolecularSequence.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "MolecularSequence.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "MolecularSequence.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "MolecularSequence.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "performer") ~}}
    <dt>{{ l10n.t "MolecularSequence.Performer" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "performer") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "MolecularSequence.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "type") ~}}
    <dt>{{ l10n.t "MolecularSequence.Type" }}</dt>
    <dd>{{ fhir.path resource "type" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "focus") ~}}
    <dt>{{ l10n.t "MolecularSequence.Focus" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "focus") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "specimen") ~}}
    <dt>{{ l10n.t "MolecularSequence.Specimen" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "specimen") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "device") ~}}
    <dt>{{ l10n.t "MolecularSequence.Device" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "device") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "literal") ~}}
    <dt>{{ l10n.t "MolecularSequence.Literal" }}</dt>
    <dd>{{ fhir.path resource "literal" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "formatted") ~}}
    <dt>{{ l10n.t "MolecularSequence.Formatted" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "formatted") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "relative") ~}}
    <dt>{{ l10n.t "MolecularSequence.Relative" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "relative") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
