{{~ # Auto-generated Scriban narrative template for AuditEvent ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/AuditEvent ~}}

<div class="fhir-narrative fhir-auditevent" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "AuditEvent.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "AuditEvent.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "AuditEvent.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "AuditEvent.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ if (fhir.exists resource "patient") ~}}
    <dt>{{ l10n.t "AuditEvent.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "AuditEvent.Encounter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "encounter") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "AuditEvent.Recorded" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "recorded") }}</dd>
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "AuditEvent.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "severity") ~}}
    <dt>{{ l10n.t "AuditEvent.Severity" }}</dt>
    <dd>{{ fhir.path resource "severity" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "AuditEvent.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "action") ~}}
    <dt>{{ l10n.t "AuditEvent.Action" }}</dt>
    <dd>{{ fhir.path resource "action" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "outcome") ~}}
    <dt>{{ l10n.t "AuditEvent.Outcome" }}</dt>
    <dd>{{ fhir.path resource "outcome" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "authorization") ~}}
    <dt>{{ l10n.t "AuditEvent.Authorization" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "authorization") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "AuditEvent.Agent" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "agent") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    <dt>{{ l10n.t "AuditEvent.Source" }}</dt>
    <dd>{{ fhir.path resource "source" }}</dd>
    {{~ if (fhir.exists resource "entity") ~}}
    <dt>{{ l10n.t "AuditEvent.Entity" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "entity") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
