{{~ # Auto-generated Scriban narrative template for Provenance ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Provenance ~}}

<div class="fhir-narrative fhir-provenance" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Provenance.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Provenance.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Provenance.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "patient") ~}}
    <dt>{{ l10n.t "Provenance.Patient" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "patient") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "Provenance.Encounter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "encounter") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recorded") ~}}
    <dt>{{ l10n.t "Provenance.Recorded" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "recorded") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Provenance.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Provenance.Target" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "target") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    <dt>{{ l10n.t "Provenance.Agent" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "agent") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ if (fhir.exists resource "entity") ~}}
    <dt>{{ l10n.t "Provenance.Entity" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "entity") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
