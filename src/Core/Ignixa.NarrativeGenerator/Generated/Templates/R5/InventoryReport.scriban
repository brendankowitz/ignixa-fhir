{{~ # Auto-generated Scriban narrative template for InventoryReport ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/InventoryReport ~}}

<div class="fhir-narrative fhir-inventoryreport" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "InventoryReport.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "InventoryReport.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "InventoryReport.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "InventoryReport.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "InventoryReport.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "InventoryReport.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "InventoryReport.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "InventoryReport.CountType" }}</dt>
    <dd>{{ fhir.path resource "countType" }}</dd>
    {{~ if (fhir.exists resource "operationType") ~}}
    <dt>{{ l10n.t "InventoryReport.OperationType" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "operationType") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "operationTypeReason") ~}}
    <dt>{{ l10n.t "InventoryReport.OperationTypeReason" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "operationTypeReason") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "InventoryReport.ReportedDateTime" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "reportedDateTime") }}</dd>
    {{~ if (fhir.exists resource "inventoryListing") ~}}
    <dt>{{ l10n.t "InventoryReport.InventoryListing" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "inventoryListing") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "InventoryReport.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
