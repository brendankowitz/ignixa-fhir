    {{~ end ~}}
    {{~ if (fhir.exists resource "timeAspect") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.TimeAspect" }}</dt>
    <dd>{{ fhir.path resource "timeAspect" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "collection") ~}}
