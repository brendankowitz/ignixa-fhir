{{~ # Auto-generated Scriban narrative template for SpecimenDefinition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/SpecimenDefinition ~}}

<div class="fhir-narrative fhir-specimendefinition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "SpecimenDefinition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "SpecimenDefinition.Id" }}">{{ fhir.path resource "id" }}</span>
