      {{~ for item in (fhir.path resource "derivedFromCanonical") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "derivedFromUri") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.DerivedFromUri" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "derivedFromUri") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "experimental") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.Experimental" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "experimental") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subject[x]") ~}}
