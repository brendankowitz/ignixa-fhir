{{~ # Auto-generated Scriban narrative template for RequestOrchestration ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/RequestOrchestration ~}}

<div class="fhir-narrative fhir-requestorchestration" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "RequestOrchestration.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "RequestOrchestration.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "RequestOrchestration.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Encounter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "encounter") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "author") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Author" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "author") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "instantiatesCanonical") ~}}
    <dt>{{ l10n.t "RequestOrchestration.InstantiatesCanonical" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "instantiatesCanonical") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "instantiatesUri") ~}}
    <dt>{{ l10n.t "RequestOrchestration.InstantiatesUri" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "instantiatesUri") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "groupIdentifier") ~}}
    <dt>{{ l10n.t "RequestOrchestration.GroupIdentifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "groupIdentifier") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "RequestOrchestration.Intent" }}</dt>
    <dd>{{ fhir.path resource "intent" }}</dd>
    {{~ if (fhir.exists resource "priority") ~}}
    <dt>{{ l10n.t "RequestOrchestration.Priority" }}</dt>
    <dd>{{ fhir.path resource "priority" }}</dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "RequestOrchestration.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
