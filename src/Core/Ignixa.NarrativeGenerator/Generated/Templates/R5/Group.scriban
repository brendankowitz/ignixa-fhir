{{~ # Auto-generated Scriban narrative template for Group ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Group ~}}

<div class="fhir-narrative fhir-group" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Group.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Group.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Group.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Group.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "Group.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "Group.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Group.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "Group.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "active") ~}}
    <dt>{{ l10n.t "Group.Active" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "active") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Group.Type" }}</dt>
    <dd>{{ fhir.path resource "type" }}</dd>
    <dt>{{ l10n.t "Group.Membership" }}</dt>
    <dd>{{ fhir.path resource "membership" }}</dd>
    {{~ if (fhir.exists resource "quantity") ~}}
    <dt>{{ l10n.t "Group.Quantity" }}</dt>
    <dd>{{ fhir.path resource "quantity" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "managingEntity") ~}}
    <dt>{{ l10n.t "Group.ManagingEntity" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "managingEntity") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "characteristic") ~}}
    <dt>{{ l10n.t "Group.Characteristic" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "characteristic") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
