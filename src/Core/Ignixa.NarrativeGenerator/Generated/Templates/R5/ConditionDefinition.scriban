{{~ # Auto-generated Scriban narrative template for ConditionDefinition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ConditionDefinition ~}}

<div class="fhir-narrative fhir-conditiondefinition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ConditionDefinition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ConditionDefinition.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ConditionDefinition.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ConditionDefinition.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "severity") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Severity" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "severity") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "bodySite") ~}}
    <dt>{{ l10n.t "ConditionDefinition.BodySite" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "bodySite") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "url") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Url" }}</dt>
    <dd>{{ fhir.path resource "url" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "version") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Version" }}</dt>
    <dd>{{ fhir.path resource "version" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "versionAlgorithm[x]") ~}}
    <dt>{{ l10n.t "ConditionDefinition.VersionAlgorithm" }}</dt>
    <dd>{{ fhir.path resource "versionAlgorithm[x]" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "title") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Title" }}</dt>
    <dd>{{ fhir.path resource "title" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "experimental") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Experimental" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "experimental") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "publisher") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Publisher" }}</dt>
    <dd>{{ fhir.path resource "publisher" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "contact") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Contact" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "contact") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "useContext") ~}}
    <dt>{{ l10n.t "ConditionDefinition.UseContext" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "useContext") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "jurisdiction") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Jurisdiction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "jurisdiction") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "stage") ~}}
    <dt>{{ l10n.t "ConditionDefinition.Stage" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "stage") }}</dd>
    {{~ end ~}}
  </dl>

</div>
