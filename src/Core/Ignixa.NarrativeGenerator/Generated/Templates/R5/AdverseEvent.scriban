    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "AdverseEvent.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
