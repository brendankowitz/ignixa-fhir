        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "mitigatingAction") ~}}
    <dt>{{ l10n.t "AdverseEvent.MitigatingAction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "mitigatingAction") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "supportingInfo") ~}}
