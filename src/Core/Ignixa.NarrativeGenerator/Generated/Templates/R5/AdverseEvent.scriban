    {{~ end ~}}
    {{~ if (fhir.exists resource "outcome") ~}}
    <dt>{{ l10n.t "AdverseEvent.Outcome" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "outcome") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recorder") ~}}
    <dt>{{ l10n.t "AdverseEvent.Recorder" }}</dt>
