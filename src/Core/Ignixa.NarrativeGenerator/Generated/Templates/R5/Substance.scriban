{{~ # Auto-generated Scriban narrative template for Substance ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Substance ~}}

<div class="fhir-narrative fhir-substance" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Substance.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Substance.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Substance.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Substance.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "status") ~}}
    <dt>{{ l10n.t "Substance.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Substance.Code" }}</dt>
    <dd>{{ fhir.path resource "code" }}</dd>
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "Substance.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Substance.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "Substance.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Substance.Instance" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "instance") }}</dd>
    {{~ if (fhir.exists resource "expiry") ~}}
    <dt>{{ l10n.t "Substance.Expiry" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "expiry") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "quantity") ~}}
    <dt>{{ l10n.t "Substance.Quantity" }}</dt>
    <dd>{{ fhir.format_quantity (fhir.path resource "quantity") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "ingredient") ~}}
    <dt>{{ l10n.t "Substance.Ingredient" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "ingredient") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
