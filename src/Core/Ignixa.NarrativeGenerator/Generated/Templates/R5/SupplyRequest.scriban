{{~ # Auto-generated Scriban narrative template for SupplyRequest ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/SupplyRequest ~}}

<div class="fhir-narrative fhir-supplyrequest" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "SupplyRequest.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "SupplyRequest.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "SupplyRequest.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "SupplyRequest.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "status") ~}}
    <dt>{{ l10n.t "SupplyRequest.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "SupplyRequest.Category" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "category") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "SupplyRequest.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "basedOn") ~}}
    <dt>{{ l10n.t "SupplyRequest.BasedOn" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "basedOn") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "priority") ~}}
    <dt>{{ l10n.t "SupplyRequest.Priority" }}</dt>
    <dd>{{ fhir.path resource "priority" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "SupplyRequest.Item" }}</dt>
    <dd>{{ fhir.path resource "item" }}</dd>
    <dt>{{ l10n.t "SupplyRequest.Quantity" }}</dt>
    <dd>{{ fhir.format_quantity (fhir.path resource "quantity") }}</dd>
    {{~ if (fhir.exists resource "occurrence[x]") ~}}
    <dt>{{ l10n.t "SupplyRequest.Occurrence" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "occurrence[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "authoredOn") ~}}
    <dt>{{ l10n.t "SupplyRequest.AuthoredOn" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "authoredOn") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "requester") ~}}
    <dt>{{ l10n.t "SupplyRequest.Requester" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "requester") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "supplier") ~}}
    <dt>{{ l10n.t "SupplyRequest.Supplier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "supplier") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
