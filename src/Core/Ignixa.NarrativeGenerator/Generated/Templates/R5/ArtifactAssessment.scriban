{{~ # Auto-generated Scriban narrative template for ArtifactAssessment ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ArtifactAssessment ~}}

<div class="fhir-narrative fhir-artifactassessment" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ArtifactAssessment.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ArtifactAssessment.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ArtifactAssessment.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ArtifactAssessment.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "ArtifactAssessment.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ArtifactAssessment.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "title") ~}}
    <dt>{{ l10n.t "ArtifactAssessment.Title" }}</dt>
    <dd>{{ fhir.path resource "title" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "lastReviewDate") ~}}
    <dt>{{ l10n.t "ArtifactAssessment.LastReviewDate" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "lastReviewDate") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ArtifactAssessment.Artifact" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "artifact[x]") }}</dd>
    {{~ if (fhir.exists resource "workflowStatus") ~}}
    <dt>{{ l10n.t "ArtifactAssessment.WorkflowStatus" }}</dt>
    <dd>{{ fhir.path resource "workflowStatus" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "disposition") ~}}
    <dt>{{ l10n.t "ArtifactAssessment.Disposition" }}</dt>
    <dd>{{ fhir.path resource "disposition" }}</dd>
    {{~ end ~}}
  </dl>

</div>
