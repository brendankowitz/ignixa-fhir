{{~ # Auto-generated Scriban narrative template for Transport ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Transport ~}}

<div class="fhir-narrative fhir-transport" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Transport.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Transport.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Transport.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Transport.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "status") ~}}
    <dt>{{ l10n.t "Transport.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "Transport.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "Transport.Encounter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "encounter") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Transport.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "Transport.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "Transport.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "instantiatesCanonical") ~}}
    <dt>{{ l10n.t "Transport.InstantiatesCanonical" }}</dt>
    <dd>{{ fhir.path resource "instantiatesCanonical" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "instantiatesUri") ~}}
    <dt>{{ l10n.t "Transport.InstantiatesUri" }}</dt>
    <dd>{{ fhir.path resource "instantiatesUri" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "basedOn") ~}}
    <dt>{{ l10n.t "Transport.BasedOn" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "basedOn") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "groupIdentifier") ~}}
    <dt>{{ l10n.t "Transport.GroupIdentifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "groupIdentifier") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "partOf") ~}}
    <dt>{{ l10n.t "Transport.PartOf" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "partOf") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "statusReason") ~}}
    <dt>{{ l10n.t "Transport.StatusReason" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "statusReason") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Transport.Intent" }}</dt>
    <dd>{{ fhir.path resource "intent" }}</dd>
    {{~ if (fhir.exists resource "focus") ~}}
    <dt>{{ l10n.t "Transport.Focus" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "focus") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "for") ~}}
    <dt>{{ l10n.t "Transport.For" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "for") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "completionTime") ~}}
    <dt>{{ l10n.t "Transport.CompletionTime" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "completionTime") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "lastModified") ~}}
    <dt>{{ l10n.t "Transport.LastModified" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "lastModified") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "requester") ~}}
    <dt>{{ l10n.t "Transport.Requester" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "requester") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "owner") ~}}
    <dt>{{ l10n.t "Transport.Owner" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "owner") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "location") ~}}
    <dt>{{ l10n.t "Transport.Location" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "location") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Transport.RequestedLocation" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "requestedLocation") }}</dd>
    <dt>{{ l10n.t "Transport.CurrentLocation" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "currentLocation") }}</dd>
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "Transport.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
