{{~ # Auto-generated Scriban narrative template for SubstanceProtein ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/SubstanceProtein ~}}

<div class="fhir-narrative fhir-substanceprotein" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "SubstanceProtein.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "SubstanceProtein.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "SubstanceProtein.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "SubstanceProtein.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "sequenceType") ~}}
    <dt>{{ l10n.t "SubstanceProtein.SequenceType" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "sequenceType") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "numberOfSubunits") ~}}
    <dt>{{ l10n.t "SubstanceProtein.NumberOfSubunits" }}</dt>
    <dd>{{ fhir.path resource "numberOfSubunits" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "disulfideLinkage") ~}}
    <dt>{{ l10n.t "SubstanceProtein.DisulfideLinkage" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "disulfideLinkage") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subunit") ~}}
    <dt>{{ l10n.t "SubstanceProtein.Subunit" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "subunit") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
