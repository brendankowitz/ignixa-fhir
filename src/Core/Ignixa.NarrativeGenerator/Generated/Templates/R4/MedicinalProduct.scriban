{{~ # Auto-generated Scriban narrative template for MedicinalProduct ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MedicinalProduct ~}}

<div class="fhir-narrative fhir-medicinalproduct" lang="{{ l10n.lang }}">
