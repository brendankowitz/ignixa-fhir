{{~ # Auto-generated Scriban narrative template for Appointment ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Appointment ~}}

<div class="fhir-narrative fhir-appointment" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Appointment.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Appointment.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Appointment.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Appointment.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Appointment.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Appointment.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "Appointment.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "cancelationReason") ~}}
    <dt>{{ l10n.t "Appointment.CancelationReason" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "cancelationReason") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "serviceCategory") ~}}
    <dt>{{ l10n.t "Appointment.ServiceCategory" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "serviceCategory") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "serviceType") ~}}
    <dt>{{ l10n.t "Appointment.ServiceType" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "serviceType") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "specialty") ~}}
    <dt>{{ l10n.t "Appointment.Specialty" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "specialty") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "appointmentType") ~}}
    <dt>{{ l10n.t "Appointment.AppointmentType" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "appointmentType") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "reasonCode") ~}}
    <dt>{{ l10n.t "Appointment.ReasonCode" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "reasonCode") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "start") ~}}
    <dt>{{ l10n.t "Appointment.Start" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "start") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "end") ~}}
    <dt>{{ l10n.t "Appointment.End" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "end") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Appointment.Participant" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "participant") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
  </dl>

</div>
