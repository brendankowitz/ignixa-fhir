    <span class="fhir-id" aria-label="{{ l10n.t "MedicinalProductIndication.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.Subject" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "subject") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "diseaseSymptomProcedure") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.DiseaseSymptomProcedure" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "diseaseSymptomProcedure") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "diseaseStatus") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.DiseaseStatus" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "diseaseStatus") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "comorbidity") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.Comorbidity" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "comorbidity") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "intendedEffect") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.IntendedEffect" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "intendedEffect") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "duration") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.Duration" }}</dt>
    <dd>{{ fhir.format_quantity (fhir.path resource "duration") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "otherTherapy") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.OtherTherapy" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "otherTherapy") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "undesirableEffect") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.UndesirableEffect" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "undesirableEffect") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "population") ~}}
    <dt>{{ l10n.t "MedicinalProductIndication.Population" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "population") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
