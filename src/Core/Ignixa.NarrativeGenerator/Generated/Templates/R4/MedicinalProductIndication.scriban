{{~ # Auto-generated Scriban narrative template for MedicinalProductIndication ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MedicinalProductIndication ~}}

<div class="fhir-narrative fhir-medicinalproductindication" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "MedicinalProductIndication.Title" }}</h3>
