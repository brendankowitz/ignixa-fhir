{{~ # Auto-generated Scriban narrative template for ObservationDefinition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/ObservationDefinition ~}}

<div class="fhir-narrative fhir-observationdefinition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "ObservationDefinition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "ObservationDefinition.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "ObservationDefinition.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "ObservationDefinition.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "ObservationDefinition.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "ObservationDefinition.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "ObservationDefinition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
  </dl>

</div>
