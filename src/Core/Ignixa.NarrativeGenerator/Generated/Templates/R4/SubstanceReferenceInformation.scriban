{{~ # Auto-generated Scriban narrative template for SubstanceReferenceInformation ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/SubstanceReferenceInformation ~}}

<div class="fhir-narrative fhir-substancereferenceinformation" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "SubstanceReferenceInformation.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "SubstanceReferenceInformation.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "SubstanceReferenceInformation.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "SubstanceReferenceInformation.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "comment") ~}}
    <dt>{{ l10n.t "SubstanceReferenceInformation.Comment" }}</dt>
    <dd>{{ fhir.path resource "comment" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "gene") ~}}
    <dt>{{ l10n.t "SubstanceReferenceInformation.Gene" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "gene") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "geneElement") ~}}
    <dt>{{ l10n.t "SubstanceReferenceInformation.GeneElement" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "geneElement") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "classification") ~}}
    <dt>{{ l10n.t "SubstanceReferenceInformation.Classification" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "classification") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "target") ~}}
    <dt>{{ l10n.t "SubstanceReferenceInformation.Target" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "target") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
