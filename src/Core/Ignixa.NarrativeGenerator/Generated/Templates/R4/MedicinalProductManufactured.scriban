{{~ # Auto-generated Scriban narrative template for MedicinalProductManufactured ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MedicinalProductManufactured ~}}

<div class="fhir-narrative fhir-medicinalproductmanufactured" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "MedicinalProductManufactured.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "MedicinalProductManufactured.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.ManufacturedDoseForm" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "manufacturedDoseForm") }}</dd>
    {{~ if (fhir.exists resource "unitOfPresentation") ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.UnitOfPresentation" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "unitOfPresentation") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.Quantity" }}</dt>
    <dd>{{ fhir.format_quantity (fhir.path resource "quantity") }}</dd>
    {{~ if (fhir.exists resource "manufacturer") ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.Manufacturer" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "manufacturer") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "ingredient") ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.Ingredient" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "ingredient") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "physicalCharacteristics") ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.PhysicalCharacteristics" }}</dt>
    <dd>{{ fhir.path resource "physicalCharacteristics" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "otherCharacteristics") ~}}
    <dt>{{ l10n.t "MedicinalProductManufactured.OtherCharacteristics" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "otherCharacteristics") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
