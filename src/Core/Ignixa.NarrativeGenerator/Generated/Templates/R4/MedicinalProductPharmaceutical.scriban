{{~ # Auto-generated Scriban narrative template for MedicinalProductPharmaceutical ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MedicinalProductPharmaceutical ~}}

<div class="fhir-narrative fhir-medicinalproductpharmaceutical" lang="{{ l10n.lang }}">
  <header class="fhir-header">
