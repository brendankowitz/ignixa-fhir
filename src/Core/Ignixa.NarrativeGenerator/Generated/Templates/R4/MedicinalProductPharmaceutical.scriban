    <span class="fhir-id" aria-label="{{ l10n.t "MedicinalProductPharmaceutical.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.AdministrableDoseForm" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "administrableDoseForm") }}</dd>
    {{~ if (fhir.exists resource "unitOfPresentation") ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.UnitOfPresentation" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "unitOfPresentation") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "ingredient") ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.Ingredient" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "ingredient") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "device") ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.Device" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "device") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "characteristics") ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.Characteristics" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "characteristics") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicinalProductPharmaceutical.RouteOfAdministration" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "routeOfAdministration") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
  </dl>

</div>
