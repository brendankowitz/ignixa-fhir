{{~ # Auto-generated Scriban narrative template for SpecimenDefinition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/SpecimenDefinition ~}}

<div class="fhir-narrative fhir-specimendefinition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "SpecimenDefinition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "SpecimenDefinition.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.Identifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "identifier") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "typeCollected") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.TypeCollected" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "typeCollected") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "patientPreparation") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.PatientPreparation" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "patientPreparation") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "timeAspect") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.TimeAspect" }}</dt>
    <dd>{{ fhir.path resource "timeAspect" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "collection") ~}}
    <dt>{{ l10n.t "SpecimenDefinition.Collection" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "collection") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
