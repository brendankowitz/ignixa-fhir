{{~ # Auto-generated Scriban narrative template for SubstanceSpecification ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/SubstanceSpecification ~}}

<div class="fhir-narrative fhir-substancespecification" lang="{{ l10n.lang }}">
