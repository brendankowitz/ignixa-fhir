{{~ # Auto-generated Scriban narrative template for Linkage ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Linkage ~}}

<div class="fhir-narrative fhir-linkage" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Linkage.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Linkage.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Linkage.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "author") ~}}
    <dt>{{ l10n.t "Linkage.Author" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "author") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Linkage.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "active") ~}}
    <dt>{{ l10n.t "Linkage.Active" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "active") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Linkage.Item" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "item") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
  </dl>

</div>
