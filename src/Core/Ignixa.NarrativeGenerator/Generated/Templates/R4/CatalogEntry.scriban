{{~ # Auto-generated Scriban narrative template for CatalogEntry ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/CatalogEntry ~}}

<div class="fhir-narrative fhir-catalogentry" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "CatalogEntry.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "CatalogEntry.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "CatalogEntry.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "CatalogEntry.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "status") ~}}
    <dt>{{ l10n.t "CatalogEntry.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "CatalogEntry.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "CatalogEntry.Orderable" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "orderable") }}</dd>
    <dt>{{ l10n.t "CatalogEntry.ReferencedItem" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "referencedItem") }}</dd>
  </dl>

</div>
