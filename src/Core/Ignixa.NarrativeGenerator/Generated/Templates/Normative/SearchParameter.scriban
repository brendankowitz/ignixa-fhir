{{~ # Auto-generated Scriban narrative template for SearchParameter ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/SearchParameter ~}}

<div class="fhir-narrative fhir-searchparameter" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "SearchParameter.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "SearchParameter.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "SearchParameter.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "SearchParameter.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "SearchParameter.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    <dt>{{ l10n.t "SearchParameter.Code" }}</dt>
    <dd>{{ fhir.path resource "code" }}</dd>
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "SearchParameter.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "SearchParameter.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "SearchParameter.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    <dt>{{ l10n.t "SearchParameter.Url" }}</dt>
    <dd>{{ fhir.path resource "url" }}</dd>
    {{~ if (fhir.exists resource "version") ~}}
    <dt>{{ l10n.t "SearchParameter.Version" }}</dt>
    <dd>{{ fhir.path resource "version" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "experimental") ~}}
    <dt>{{ l10n.t "SearchParameter.Experimental" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "experimental") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "publisher") ~}}
    <dt>{{ l10n.t "SearchParameter.Publisher" }}</dt>
    <dd>{{ fhir.path resource "publisher" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "contact") ~}}
    <dt>{{ l10n.t "SearchParameter.Contact" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "contact") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "useContext") ~}}
    <dt>{{ l10n.t "SearchParameter.UseContext" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "useContext") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "jurisdiction") ~}}
    <dt>{{ l10n.t "SearchParameter.Jurisdiction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "jurisdiction") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "SearchParameter.Base" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "base") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    <dt>{{ l10n.t "SearchParameter.Type" }}</dt>
    <dd>{{ fhir.path resource "type" }}</dd>
  </dl>

</div>
