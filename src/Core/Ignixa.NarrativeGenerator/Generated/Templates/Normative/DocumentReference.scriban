{{~ # Auto-generated Scriban narrative template for DocumentReference ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/DocumentReference ~}}

<div class="fhir-narrative fhir-documentreference" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "DocumentReference.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "DocumentReference.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "DocumentReference.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "DocumentReference.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DocumentReference.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "DocumentReference.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "author") ~}}
    <dt>{{ l10n.t "DocumentReference.Author" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "author") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "DocumentReference.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "DocumentReference.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "masterIdentifier") ~}}
    <dt>{{ l10n.t "DocumentReference.MasterIdentifier" }}</dt>
    <dd>{{ fhir.format_identifier (fhir.path resource "masterIdentifier") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "docStatus") ~}}
    <dt>{{ l10n.t "DocumentReference.DocStatus" }}</dt>
    <dd>{{ fhir.path resource "docStatus" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DocumentReference.Type" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "type") }}</dd>
    {{~ if (fhir.exists resource "class") ~}}
    <dt>{{ l10n.t "DocumentReference.Class" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "class") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "created") ~}}
    <dt>{{ l10n.t "DocumentReference.Created" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "created") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DocumentReference.Indexed" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "indexed") }}</dd>
    {{~ if (fhir.exists resource "authenticator") ~}}
    <dt>{{ l10n.t "DocumentReference.Authenticator" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "authenticator") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "custodian") ~}}
    <dt>{{ l10n.t "DocumentReference.Custodian" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "custodian") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "relatesTo") ~}}
    <dt>{{ l10n.t "DocumentReference.RelatesTo" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "relatesTo") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "securityLabel") ~}}
    <dt>{{ l10n.t "DocumentReference.SecurityLabel" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "securityLabel") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DocumentReference.Content" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "content") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ if (fhir.exists resource "context") ~}}
    <dt>{{ l10n.t "DocumentReference.Context" }}</dt>
    <dd>{{ fhir.path resource "context" }}</dd>
    {{~ end ~}}
  </dl>

</div>
