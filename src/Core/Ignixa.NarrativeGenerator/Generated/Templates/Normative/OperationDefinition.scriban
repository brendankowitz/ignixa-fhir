{{~ # Auto-generated Scriban narrative template for OperationDefinition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/OperationDefinition ~}}

<div class="fhir-narrative fhir-operationdefinition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "OperationDefinition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "OperationDefinition.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "OperationDefinition.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "OperationDefinition.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "OperationDefinition.Name" }}</dt>
    <dd>{{ fhir.path resource "name" }}</dd>
    <dt>{{ l10n.t "OperationDefinition.Code" }}</dt>
    <dd>{{ fhir.path resource "code" }}</dd>
    {{~ if (fhir.exists resource "date") ~}}
    <dt>{{ l10n.t "OperationDefinition.Date" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "date") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "OperationDefinition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "description") ~}}
    <dt>{{ l10n.t "OperationDefinition.Description" }}</dt>
    <dd>{{ fhir.path resource "description" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "url") ~}}
    <dt>{{ l10n.t "OperationDefinition.Url" }}</dt>
    <dd>{{ fhir.path resource "url" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "version") ~}}
    <dt>{{ l10n.t "OperationDefinition.Version" }}</dt>
    <dd>{{ fhir.path resource "version" }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "OperationDefinition.Kind" }}</dt>
    <dd>{{ fhir.path resource "kind" }}</dd>
    {{~ if (fhir.exists resource "experimental") ~}}
    <dt>{{ l10n.t "OperationDefinition.Experimental" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "experimental") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "publisher") ~}}
    <dt>{{ l10n.t "OperationDefinition.Publisher" }}</dt>
    <dd>{{ fhir.path resource "publisher" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "contact") ~}}
    <dt>{{ l10n.t "OperationDefinition.Contact" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "contact") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "useContext") ~}}
    <dt>{{ l10n.t "OperationDefinition.UseContext" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "useContext") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "jurisdiction") ~}}
    <dt>{{ l10n.t "OperationDefinition.Jurisdiction" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "jurisdiction") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "idempotent") ~}}
    <dt>{{ l10n.t "OperationDefinition.Idempotent" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "idempotent") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "base") ~}}
    <dt>{{ l10n.t "OperationDefinition.Base" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "base") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "resource") ~}}
    <dt>{{ l10n.t "OperationDefinition.Resource" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "resource") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "OperationDefinition.System" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "system") }}</dd>
    <dt>{{ l10n.t "OperationDefinition.Type" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "type") }}</dd>
    <dt>{{ l10n.t "OperationDefinition.Instance" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "instance") }}</dd>
  </dl>

</div>
