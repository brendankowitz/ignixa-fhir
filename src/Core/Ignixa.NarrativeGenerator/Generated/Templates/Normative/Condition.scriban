{{~ # Auto-generated Scriban narrative template for Condition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Condition ~}}

<div class="fhir-narrative fhir-condition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Condition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Condition.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Condition.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Condition.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "Condition.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Condition.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ if (fhir.exists resource "clinicalStatus") ~}}
    <dt>{{ l10n.t "Condition.ClinicalStatus" }}</dt>
    <dd>{{ fhir.path resource "clinicalStatus" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "verificationStatus") ~}}
    <dt>{{ l10n.t "Condition.VerificationStatus" }}</dt>
    <dd>{{ fhir.path resource "verificationStatus" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "Condition.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "category") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "severity") ~}}
    <dt>{{ l10n.t "Condition.Severity" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "severity") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "bodySite") ~}}
    <dt>{{ l10n.t "Condition.BodySite" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "bodySite") ~}}
        <li>{{ fhir.display_codeable_concept item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Condition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "Condition.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "context") ~}}
    <dt>{{ l10n.t "Condition.Context" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "context") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "onset[x]") ~}}
    <dt>{{ l10n.t "Condition.Onset" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "onset[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "assertedDate") ~}}
    <dt>{{ l10n.t "Condition.AssertedDate" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "assertedDate") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "asserter") ~}}
    <dt>{{ l10n.t "Condition.Asserter" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "asserter") }}</dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "Condition.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
