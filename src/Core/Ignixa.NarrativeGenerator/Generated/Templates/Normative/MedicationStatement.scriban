{{~ # Auto-generated Scriban narrative template for MedicationStatement ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/MedicationStatement ~}}

<div class="fhir-narrative fhir-medicationstatement" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "MedicationStatement.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "MedicationStatement.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "MedicationStatement.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "MedicationStatement.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicationStatement.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "MedicationStatement.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "MedicationStatement.Category" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "category") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "MedicationStatement.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "MedicationStatement.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "note") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "basedOn") ~}}
    <dt>{{ l10n.t "MedicationStatement.BasedOn" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "basedOn") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "partOf") ~}}
    <dt>{{ l10n.t "MedicationStatement.PartOf" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "partOf") ~}}
        <li>{{ fhir.display_reference item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "context") ~}}
    <dt>{{ l10n.t "MedicationStatement.Context" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "context") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicationStatement.Medication" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "medication[x]") }}</dd>
    {{~ if (fhir.exists resource "effective[x]") ~}}
    <dt>{{ l10n.t "MedicationStatement.Effective" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "effective[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "dateAsserted") ~}}
    <dt>{{ l10n.t "MedicationStatement.DateAsserted" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "dateAsserted") }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "MedicationStatement.Taken" }}</dt>
    <dd>{{ fhir.path resource "taken" }}</dd>
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "MedicationStatement.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
