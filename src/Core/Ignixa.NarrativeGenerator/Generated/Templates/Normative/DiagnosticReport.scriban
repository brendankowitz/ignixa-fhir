{{~ # Auto-generated Scriban narrative template for DiagnosticReport ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/DiagnosticReport ~}}

<div class="fhir-narrative fhir-diagnosticreport" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "DiagnosticReport.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "DiagnosticReport.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    <dt>{{ l10n.t "DiagnosticReport.Status" }}</dt>
    <dd>{{ fhir.path resource "status" }}</dd>
    <dt>{{ l10n.t "DiagnosticReport.Code" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "code") }}</dd>
    {{~ if (fhir.exists resource "subject") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Subject" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "subject") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "performer") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Performer" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "performer") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "issued") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Issued" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "issued") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Category" }}</dt>
    <dd>{{ fhir.display_codeable_concept (fhir.path resource "category") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "context") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Context" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "context") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "effective[x]") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Effective" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "effective[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "image") ~}}
    <dt>{{ l10n.t "DiagnosticReport.Image" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "image") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
