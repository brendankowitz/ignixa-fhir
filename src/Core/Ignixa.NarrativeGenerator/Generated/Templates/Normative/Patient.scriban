{{~ # Auto-generated Scriban narrative template for Patient ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Patient ~}}

<div class="fhir-narrative fhir-patient" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Patient.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Patient.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Patient.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Patient.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "identifier") ~}}
        <li>{{ fhir.format_identifier item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "name") ~}}
    <dt>{{ l10n.t "Patient.Name" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "name") ~}}
        <li>{{ fhir.format_human_name item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Patient.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "active") ~}}
    <dt>{{ l10n.t "Patient.Active" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "active") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "telecom") ~}}
    <dt>{{ l10n.t "Patient.Telecom" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "telecom") ~}}
        <li>{{ fhir.format_contact_point item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "gender") ~}}
    <dt>{{ l10n.t "Patient.Gender" }}</dt>
    <dd>{{ fhir.path resource "gender" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "birthDate") ~}}
    <dt>{{ l10n.t "Patient.BirthDate" }}</dt>
    <dd>{{ fhir.format_date (fhir.path resource "birthDate") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "deceased[x]") ~}}
    <dt>{{ l10n.t "Patient.Deceased" }}</dt>
    <dd>{{ fhir.format_boolean (fhir.path resource "deceased[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "address") ~}}
    <dt>{{ l10n.t "Patient.Address" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "address") ~}}
        <li>{{ fhir.format_address item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "animal") ~}}
    <dt>{{ l10n.t "Patient.Animal" }}</dt>
    <dd>{{ fhir.path resource "animal" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "managingOrganization") ~}}
    <dt>{{ l10n.t "Patient.ManagingOrganization" }}</dt>
    <dd>{{ fhir.display_reference (fhir.path resource "managingOrganization") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "link") ~}}
    <dt>{{ l10n.t "Patient.Link" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ for item in (fhir.path resource "link") ~}}
        <li>{{ item }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

</div>
