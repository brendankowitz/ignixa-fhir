{{~ # Auto-generated Scriban narrative template for Condition ~}}
{{~ # FHIR StructureDefinition: http://hl7.org/fhir/StructureDefinition/Condition ~}}

<div class="fhir-narrative fhir-condition" lang="{{ l10n.lang }}">
  <header class="fhir-header">
    <h3 class="fhir-resource-type">{{ l10n.t "Condition.Title" }}</h3>
    {{~ if (fhir.exists resource "id") ~}}
    <span class="fhir-id" aria-label="{{ l10n.t "Condition.Id" }}">{{ fhir.path resource "id" }}</span>
    {{~ end ~}}
  </header>

  <dl class="fhir-details">
    {{~ if (fhir.exists resource "id") ~}}
    <dt>{{ l10n.t "Condition.Id" }}</dt>
    <dd>{{ fhir.path resource "id" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "identifier") ~}}
    <dt>{{ l10n.t "Condition.Identifier" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ item_count = fhir.count resource "identifier" ~}}
      {{~ for i in 0..(item_count - 1) ~}}
      {{~ id_value = fhir.path resource ("identifier[" + i + "].value") ~}}
      {{~ id_system = fhir.path resource ("identifier[" + i + "].system") ~}}
      {{~ id_type = fhir.path resource ("identifier[" + i + "].type.coding.first().display") ~}}
        <li>
          {{~ if id_type && id_type != "" ~}}<span class="identifier-type">{{ id_type }}:</span> {{~ end ~}}
          <span class="identifier-value">{{ id_value }}</span>
          {{~ if id_system && id_system != "" ~}} <span class="identifier-system">({{ id_system }})</span>{{~ end ~}}
        </li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "code") ~}}
    <dt>{{ l10n.t "Condition.Code" }}</dt>
    {{~ cc_display = fhir.path resource "code.coding.first().display" ~}}
    {{~ cc_code = fhir.path resource "code.coding.first().code" ~}}
    <dd>{{ (cc_display && cc_display != "") ? cc_display : cc_code }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Condition.Subject" }}</dt>
    {{~ ref_display = fhir.path resource "subject.display" ~}}
    {{~ ref_reference = fhir.path resource "subject.reference" ~}}
    <dd>{{ (ref_display && ref_display != "") ? ref_display : ref_reference }}</dd>
    {{~ if (fhir.exists resource "encounter") ~}}
    <dt>{{ l10n.t "Condition.Encounter" }}</dt>
    {{~ ref_display = fhir.path resource "encounter.display" ~}}
    {{~ ref_reference = fhir.path resource "encounter.reference" ~}}
    <dd>{{ (ref_display && ref_display != "") ? ref_display : ref_reference }}</dd>
    {{~ end ~}}
    <dt>{{ l10n.t "Condition.ClinicalStatus" }}</dt>
    {{~ cc_display = fhir.path resource "clinicalStatus.coding.first().display" ~}}
    {{~ cc_code = fhir.path resource "clinicalStatus.coding.first().code" ~}}
    <dd>{{ (cc_display && cc_display != "") ? cc_display : cc_code }}</dd>
    {{~ if (fhir.exists resource "verificationStatus") ~}}
    <dt>{{ l10n.t "Condition.VerificationStatus" }}</dt>
    {{~ cc_display = fhir.path resource "verificationStatus.coding.first().display" ~}}
    {{~ cc_code = fhir.path resource "verificationStatus.coding.first().code" ~}}
    <dd>{{ (cc_display && cc_display != "") ? cc_display : cc_code }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "category") ~}}
    <dt>{{ l10n.t "Condition.Category" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ item_count = fhir.count resource "category" ~}}
      {{~ for i in 0..(item_count - 1) ~}}
      {{~ cc_display = fhir.path resource ("category[" + i + "].coding.first().display") ~}}
      {{~ cc_code = fhir.path resource ("category[" + i + "].coding.first().code") ~}}
        <li>{{ (cc_display && cc_display != "") ? cc_display : cc_code }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "severity") ~}}
    <dt>{{ l10n.t "Condition.Severity" }}</dt>
    {{~ cc_display = fhir.path resource "severity.coding.first().display" ~}}
    {{~ cc_code = fhir.path resource "severity.coding.first().code" ~}}
    <dd>{{ (cc_display && cc_display != "") ? cc_display : cc_code }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "bodySite") ~}}
    <dt>{{ l10n.t "Condition.BodySite" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ item_count = fhir.count resource "bodySite" ~}}
      {{~ for i in 0..(item_count - 1) ~}}
      {{~ cc_display = fhir.path resource ("bodySite[" + i + "].coding.first().display") ~}}
      {{~ cc_code = fhir.path resource ("bodySite[" + i + "].coding.first().code") ~}}
        <li>{{ (cc_display && cc_display != "") ? cc_display : cc_code }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "text") ~}}
    <dt>{{ l10n.t "Condition.Text" }}</dt>
    <dd>{{ fhir.path resource "text" }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "note") ~}}
    <dt>{{ l10n.t "Condition.Note" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ item_count = fhir.count resource "note" ~}}
      {{~ for i in 0..(item_count - 1) ~}}
      {{~ item_value = fhir.path resource ("note[" + i + "]") ~}}
        <li>{{ item_value }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "onset[x]") ~}}
    <dt>{{ l10n.t "Condition.Onset" }}</dt>
    <dd>{{ fhir.format_datetime (fhir.path resource "onset[x]") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recordedDate") ~}}
    <dt>{{ l10n.t "Condition.RecordedDate" }}</dt>
    <dd>{{ fhir.format_datetime (fhir.path resource "recordedDate") }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "recorder") ~}}
    <dt>{{ l10n.t "Condition.Recorder" }}</dt>
    {{~ ref_display = fhir.path resource "recorder.display" ~}}
    {{~ ref_reference = fhir.path resource "recorder.reference" ~}}
    <dd>{{ (ref_display && ref_display != "") ? ref_display : ref_reference }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "asserter") ~}}
    <dt>{{ l10n.t "Condition.Asserter" }}</dt>
    {{~ ref_display = fhir.path resource "asserter.display" ~}}
    {{~ ref_reference = fhir.path resource "asserter.reference" ~}}
    <dd>{{ (ref_display && ref_display != "") ? ref_display : ref_reference }}</dd>
    {{~ end ~}}
    {{~ if (fhir.exists resource "evidence") ~}}
    <dt>{{ l10n.t "Condition.Evidence" }}</dt>
    <dd>
      <ul class="fhir-list">
      {{~ item_count = fhir.count resource "evidence" ~}}
      {{~ for i in 0..(item_count - 1) ~}}
      {{~ item_value = fhir.path resource ("evidence[" + i + "]") ~}}
        <li>{{ item_value }}</li>
      {{~ end ~}}
      </ul>
    </dd>
    {{~ end ~}}
  </dl>

  {{~ if (fhir.exists resource "note") ~}}
  <section class="fhir-notes" aria-labelledby="notes-heading-{{ fhir.path resource "id" }}">
    <h4 id="notes-heading-{{ fhir.path resource "id" }}">{{ l10n.t "Condition.Notes" }}</h4>
    <ul>
    {{~ for note in (fhir.path resource "note") ~}}
      <li>{{ fhir.path note "text" }}</li>
    {{~ end ~}}
    </ul>
  </section>
  {{~ end ~}}
</div>
