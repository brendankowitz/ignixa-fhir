<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Shared gRPC contracts for Ignixa sidecar integration (Metrics, Audit, RBAC services)</Description>
    <Authors>Platform Engineering Team</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- gRPC tooling for code generation -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include all .proto files and generate both client and server code -->
    <Protobuf Include="Protos\ignixa_metrics.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\ignixa_audit.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\ignixa_rbac.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
