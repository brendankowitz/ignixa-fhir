<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Core dependencies - reference Application for shared infrastructure -->
    <ProjectReference Include="..\Ignixa.Application\Ignixa.Application.csproj" />
    <ProjectReference Include="..\Ignixa.Domain\Ignixa.Domain.csproj" />

    <!-- Transform dependencies -->
    <ProjectReference Include="..\..\Core\Ignixa.FhirMappingLanguage\Ignixa.FhirMappingLanguage.csproj" />
    <ProjectReference Include="..\..\Core\Ignixa.FhirPath\Ignixa.FhirPath.csproj" />
    <ProjectReference Include="..\..\Core\Ignixa.Validation\Ignixa.Validation.csproj" />
    <ProjectReference Include="..\..\Core\Ignixa.Serialization\Ignixa.Serialization.csproj" />
    <ProjectReference Include="..\..\Core\Ignixa.PackageManagement\Ignixa.PackageManagement.csproj" />
    <ProjectReference Include="..\..\DataLayer\Ignixa.DataLayer.FileSystem\Ignixa.DataLayer.FileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP dependencies -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />

    <!-- Standard dependencies (versions from Directory.Packages.props) -->
    <PackageReference Include="Autofac" />
    <PackageReference Include="Medino" />
    <PackageReference Include="Microsoft.AspNetCore.Http" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference ASP.NET Core framework for web types -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Add ASP.NET Core implicit usings -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Enable packaging for internal GitHub Packages feed -->
    <IsPackable>true</IsPackable>
    <PackageId>Ignixa.Application.Experimental</PackageId>
    <Description>Experimental features for Ignixa FHIR Server including MCP, $transform, and Terminology operations</Description>
    <PackageTags>FHIR;HL7;Healthcare;Experimental;MCP</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
