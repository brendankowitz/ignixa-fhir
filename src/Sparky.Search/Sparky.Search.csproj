<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparky.Domain\Sparky.Domain.csproj" />
    <ProjectReference Include="..\Sparky.Extensions\Sparky.Extensions.csproj" />
    <ProjectReference Include="..\Sparky.SourceNodeSerialization\Sparky.SourceNodeSerialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data" />
    <Folder Include="Models" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Data\R4\BaseCapabilities.json" />
    <EmbeddedResource Include="Data\R4\BaseCapabilities.json" />
    <None Remove="Data\R4\unsupported-search-parameters.json" />
    <EmbeddedResource Include="Data\R4\unsupported-search-parameters.json" />
    <None Remove="Data\R5\BaseCapabilities.json" />
    <EmbeddedResource Include="Data\R5\BaseCapabilities.json" />
    <None Remove="Data\R5\unsupported-search-parameters.json" />
    <EmbeddedResource Include="Data\R5\unsupported-search-parameters.json" />
    <None Remove="Data\Stu3\BaseCapabilities.json" />
    <EmbeddedResource Include="Data\Stu3\BaseCapabilities.json" />
    <None Remove="Data\Stu3\unsupported-search-parameters.json" />
    <EmbeddedResource Include="Data\Stu3\unsupported-search-parameters.json" />
    <None Remove="Data\R4B\BaseCapabilities.json" />
    <EmbeddedResource Include="Data\R4B\BaseCapabilities.json" />
    <None Remove="Data\R4B\unsupported-search-parameters.json" />
    <EmbeddedResource Include="Data\R4B\unsupported-search-parameters.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Definition\VersionAwareSearchParameterDefinitionManager.cs">
      <DependentUpon>SupportedSearchParameterDefinitionManager.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
