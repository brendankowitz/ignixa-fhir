<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Suppress CLS-compliance warnings for interfaces from Sparky.Domain -->
    <NoWarn>$(NoWarn);CS3001;CS3002;CS3027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ensure.That" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ValueSets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparky.Domain\Sparky.Domain.csproj" />
  </ItemGroup>

</Project>
