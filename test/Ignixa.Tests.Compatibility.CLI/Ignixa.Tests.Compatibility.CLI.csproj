<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Ignixa.Tests.Compatibility.CLI</RootNamespace>
    <AssemblyName>fhir-compat</AssemblyName>
    <!-- This standalone upstream test runner has no server project references. Its transitive
         dependencies must follow the E2E package rather than the server's unrelated package pins. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <NoWarn>CA1303,CA1869,CA1861,CA2000,CA1031,CA1852,IDE0073,CA1307,CA1310</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="xunit.runner.utility" />
    <PackageReference Include="Microsoft.Health.Fhir.R4.Tests.E2E" />
    <!-- Fixed transitive dependencies for the upstream corpus; scoped to this standalone CLI. -->
    <PackageReference Include="AngleSharp" VersionOverride="1.5.0" />
    <PackageReference Include="OpenTelemetry.Api" VersionOverride="1.15.3" />
    <PackageReference Include="SharpCompress" VersionOverride="0.48.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="test-results-viewer.html" />
    <EmbeddedResource Include="test-results-viewer.html" />
  </ItemGroup>

</Project>
