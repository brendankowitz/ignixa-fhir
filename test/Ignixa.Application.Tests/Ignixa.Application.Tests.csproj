<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Suppress test-specific code analysis warnings -->
    <NoWarn>$(NoWarn);CA1707;CA1849;CA2000;CA2012;CS8604;CS8625;CA1303;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Application\Ignixa.Application\Ignixa.Application.csproj" />
    <ProjectReference Include="..\..\src\Application\Ignixa.Application.Operations\Ignixa.Application.Operations.csproj" />
    <ProjectReference Include="..\..\src\Application\Ignixa.Application.BackgroundOperations\Ignixa.Application.BackgroundOperations.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.Specification\Ignixa.Specification.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.Search\Ignixa.Search.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.Search.Sql\Ignixa.Search.Sql.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.FhirFakes\Ignixa.FhirFakes.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.Serialization\Ignixa.Serialization.csproj" />
    <ProjectReference Include="..\..\src\Core\Ignixa.DeId\Ignixa.DeId.csproj" />
    <ProjectReference Include="..\Ignixa.Serialization.TestSupport\Ignixa.Serialization.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The snapshot tests read these at runtime. They used to be located via [CallerFilePath], a
         compile-time path that becomes /_/... under ContinuousIntegrationBuild, so the tests passed
         locally and threw DirectoryNotFoundException on every CI run. -->
    <None Update="Features\Bundle\Serialization\Snapshots\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

