<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Suppress CA1051 for test base classes with protected fields -->
    <NoWarn>$(NoWarn);CA1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal test classes to xUnit test runners -->
    <InternalsVisibleTo Include="xunit.runner.visualstudio.dotnetcore.testadapter" />
    <InternalsVisibleTo Include="xunit.runner.utility.netcoreapp10" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Application/Ignixa.Web/Ignixa.Web.csproj" />
    <ProjectReference Include="../../src/Application/Ignixa.Application/Ignixa.Application.csproj" />
    <ProjectReference Include="../../src/Core/Ignixa.Abstractions/Ignixa.Abstractions.csproj" />
    <ProjectReference Include="../../src/Core/Ignixa.FhirFakes/Ignixa.FhirFakes.csproj" />
    <ProjectReference Include="../../src/Core/Ignixa.Serialization/Ignixa.Serialization.csproj" />
    <ProjectReference Include="../../src/Core/Ignixa.Specification/Ignixa.Specification.csproj" />
    <ProjectReference Include="../../src/Core/Ignixa.TestScript/Ignixa.TestScript.csproj" />
    <ProjectReference Include="../../src/Core/Ignixa.TestScript.FhirFakes/Ignixa.TestScript.FhirFakes.csproj" />
  </ItemGroup>

  <!--
    Explicit import, not a ProjectReference: NuGet auto-imports build/*.targets for
    PackageReference consumers only. This gives the in-repo test the same suite-delivery
    path that packaged consumers get, so a break in the targets file fails here rather
    than downstream after a publish.
  -->
  <Import Project="..\..\src\Core\Ignixa.TestScript.Suites\build\Ignixa.TestScript.Suites.targets" />

</Project>
